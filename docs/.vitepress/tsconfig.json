{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2023", "DOM"]
  },
  "contentMappers": [{ "package": "@vue/content-mapper", "extensions": [".vue"] }],
  "include": ["config.ts", "theme/**/*.ts", "theme/**/*.vue"]
}

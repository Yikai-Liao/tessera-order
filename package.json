{
  "name": "tessera-sort-docs",
  "private": true,
  "description": "Documentation site for Tessera; see docs/development/docs-site.md",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "vue-tsc --noEmit -p docs/.vitepress",
    "docs:test": "node --test \"docs/.vitepress/theme/sim/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "markdown-it-mathjax3": "^4.3.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}

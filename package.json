{
  "name": "tessera-sort-tools",
  "private": true,
  "description": "Documentation site and CI tooling for Tessera",
  "type": "module",
  "scripts": {
    "lint": "bun run --bun biome ci .",
    "format": "bun run --bun biome check --write .",
    "docs:dev": "bun run --bun vitepress dev docs",
    "docs:build": "bun run --bun vitepress build docs",
    "docs:preview": "bun run --bun vitepress preview docs",
    "docs:typecheck": "bun docs/.vitepress/typecheck.ts --noEmit -p docs/.vitepress",
    "docs:test": "bun test --timeout 30000 ./docs/.vitepress",
    "tools": "bun tools/index.ts",
    "tools:aot:build": "bun compile tools/index.ts --asset bench/catalog.toml --asset bench/plans --asset bench/rust/native/sources.toml --disallow-code-generation-from-strings=strict --outfile target/dev-tools/tessera-tools",
    "tools:test": "bun test --timeout 30000 ./tools ./bench ./.github/scripts",
    "tools:typecheck": "bun run --bun tsc --noEmit -p bench && bun run --bun tsc --noEmit -p bench/plot"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@biomejs/biome": "2.6.6",
    "@observablehq/plot": "^0.6.19",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/string-pixel-width": "^1.11.0",
    "commander": "^15.1.0",
    "linkedom": "^0.18.15",
    "markdown-it-mathjax3": "^4.3.2",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.9.1",
    "string-pixel-width": "^1.11.0",
    "tar": "^7.5.22",
    "typescript": "7.1.0-beta",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vue": "^3.5.45",
    "vue-tsc": "3.3.14",
    "zod": "^4.6.7"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ]
}

+                // narrow-window children large enough to exceed a tile. The default
+                // eight-bit root leaves about 8192 records per child, above 4096.
+                let base =
+                    0x0123_4567_89ab_cdef_1122_3344_5566_7788u128 & !(0xff00_00ffu128 << shift);
+                let input: Vec<_> = (0..2_097_153)
+                    .map(|id| {
+                        let mixed = (id as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15);
+                        base | (((u128::from(mixed) & 255)
+                            | ((u128::from(mixed >> 32) & 255) << 24))
+                            << shift)
+                    })
+                    .collect();
+                let mut expected = input.clone();
+                expected.sort();
+                let trace = counted(Direct);
+                let fills = trace.fills.clone();
+                let mut actual = input;
+                sort::<_, _, false>(&mut actual, trace);
+                assert_eq!(actual, expected);
+                assert!(
+                    fills.load(Relaxed) > 1,
+                    "child counting was not reached at half {shift}"
+                );
+            }
+        });
+}

+    #[test]
+    fn native_scatter_exclusive_borrows_and_inconsistent_keys() {
+        let len = if cfg!(miri) { 23 } else { 113 };
+        for inconsistent in [false, true] {
+            let mut backing: Vec<_> = (0..len).collect();
+            let mut records: Vec<_> = backing.iter_mut().enumerate().collect();
+            let calls = AtomicUsize::new(0);
+            partition_impl(
+                &mut records,
+                3,
+                0,
+                ByKey(|row: &(usize, &mut usize)| {
+                    let call = calls.fetch_add(1, Ordering::Relaxed);
+                    (if inconsistent {
+                        call ^ row.0
+                    } else {
+                        row.0 * 37
+                    }) as u64
+                }),
+                &mut Buffers::new(),
+                config(4, 5),
+            );
+            let mut ids = Vec::new();
+            for (id, record) in records {
+                assert_eq!(id, *record);
+                *record += 1;
+                ids.push(id);
+            }
+            ids.sort_unstable();
+            assert_eq!(ids, (0..len).collect::<Vec<_>>());
+            assert_eq!(backing, (1..=len).collect::<Vec<_>>());
+        }
+    }

+fn parallel_single_digit_root_counts_direct_and_partitions_by_key() {
+    for threads in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(threads)
+            .build()
+            .unwrap()
+            .install(|| {
+                for low in [0usize, 57, 64, 120] {
+                    let width = if low == 57 { 7 } else { 8 };
+                    let mask = ((1u128 << width) - 1) << low;
+                    let base = 0x19b2_34c5_d6e7_f809_a1b2_c3d4_e5f6_0000u128 & !mask;
+                    let input: Vec<_> = (0..65_537)
+                        .map(|id| base | (((id as u128 * 181) << low) & mask))
+                        .collect();
+                    let mut expected = input.clone();
+                    expected.sort();
+                    let trace = counted(Direct);
+                    let fills = trace.fills.clone();
+                    let mut actual = input.clone();
+                    sort::<_, _, false>(&mut actual, trace);
+                    assert_eq!(actual, expected);
+                    assert_eq!(fills.load(Relaxed), 1, "threads={threads} low={low}");
+
+                    let mut rows: Vec<_> = input
+                        .into_iter()
+                        .enumerate()
+                        .map(|(id, key)| (key, id))
+                        .collect();
+                    let mut wanted = rows.clone();
+                    wanted.sort_by_key(|row| row.0);
+                    let trace = counted(ByKey(|row: &(u128, usize)| row.0));
+                    let fills = trace.fills.clone();
+                    sort::<_, _, true>(&mut rows, trace);
+                    assert_eq!(fills.load(Relaxed), 0);
+                    assert_eq!(rows, wanted);
+                }
+            });
+    }

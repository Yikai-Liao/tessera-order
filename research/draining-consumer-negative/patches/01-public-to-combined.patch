+    #[test]
+    fn native_scatter_stable_partial_boundaries() {
+        let lengths: Vec<_> = if cfg!(miri) {
+            vec![2, 7, 19, 33]
+        } else {
+            (2..90).collect()
+        };
+        let sizes: Vec<_> = if cfg!(miri) {
+            vec![1, 5]
+        } else {
+            vec![1, 2, 3, 5, 8, 32]
+        };
+        for len in lengths {
+            for &block_size in &sizes {
+                for shards in [1, 2, 4] {
+                    for radix in [1, 3] {
+                        let mut rows: Vec<_> = (0..len)
+                            .map(|id| (((id * 37 + 11) % 256) as u64, id))
+                            .collect();
+                        let mut expected = rows.clone();
+                        let mask = (1u64 << radix) - 1;
+                        expected.sort_by_key(|row| row.0 & mask);
+                        let ends = partition_impl(
+                            &mut rows,
+                            radix,
+                            0,
+                            ByKey(|row: &(u64, usize)| row.0),
+                            &mut Buffers::new(),
+                            config(shards, block_size),
+                        );
+                        assert_eq!(
+                            rows, expected,
+                            "n={len}, b={block_size}, P={shards}, radix={radix}"
+                        );
+                        for (bucket, end) in ends.into_iter().enumerate() {
+                            assert_eq!(
+                                end,
+                                rows.iter()
+                                    .filter(|row| row.0 & mask <= bucket as u64)
+                                    .count()
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    struct Owned {
+        key: u64,
+        id: usize,
+        text: String,
+        drops: Arc<Vec<AtomicUsize>>,
+    }
+
+    impl Drop for Owned {
+        fn drop(&mut self) {
+            assert_eq!(self.text, self.id.to_string());
+            self.drops[self.id].fetch_add(1, Ordering::SeqCst);
+        }
+    }
+
+    #[test]
+    fn native_scatter_owned_panic_restores_each_shard() {
+        let len = if cfg!(miri) { 19 } else { 97 };
+        for fail in (0..len).chain([usize::MAX]) {
+            let drops = Arc::new((0..len).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+            let mut rows: Vec<_> = (0..len)
+                .map(|id| Owned {
+                    key: ((id * 37 + 11) % 16) as u64,
+                    id,
+                    text: id.to_string(),
+                    drops: drops.clone(),
+                })
+                .collect();
+            let result = catch_unwind(AssertUnwindSafe(|| {
+                partition_impl(
+                    &mut rows,
+                    3,
+                    0,
+                    ByKey(|row: &Owned| {
+                        assert_ne!(row.id, fail, "injected key panic");
+                        row.key
+                    }),
+                    &mut Buffers::new(),
+                    config(4, 5),
+                );
+            }));
+            assert_eq!(result.is_err(), fail != usize::MAX);
+            let mut ids: Vec<_> = rows.iter().map(|row| row.id).collect();
+            ids.sort_unstable();
+            assert_eq!(ids, (0..len).collect::<Vec<_>>());
+            assert!(drops.iter().all(|count| count.load(Ordering::SeqCst) == 0));
+            drop(rows);
+            assert!(drops.iter().all(|count| count.load(Ordering::SeqCst) == 1));
+        }
+    }

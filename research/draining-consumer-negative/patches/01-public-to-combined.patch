+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Attribute the shared narrow-window route to Direct, never `ByKey` payloads.
+
+use super::*;
+use crate::RadixKey;
+use crate::key::ByKey;
+use alloc::sync::Arc;
+use core::cmp::Reverse;
+use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+#[derive(Clone)]
+pub(super) struct Counted<E> {
+    inner: E,
+    attempts: Arc<AtomicUsize>,
+    pub(super) fills: Arc<AtomicUsize>,
+}
+
+impl<T, E: Extract<T>> Extract<T> for Counted<E> {
+    type Value = E::Value;
+
+    fn key(&mut self, record: &T) -> Self::Value {
+        self.inner.key(record)
+    }
+
+    fn try_count_window(&mut self, records: &mut [T], low: usize, width: usize) -> bool {
+        self.attempts.fetch_add(1, Relaxed);
+        let filled = self.inner.try_count_window(records, low, width);
+        self.fills.fetch_add(usize::from(filled), Relaxed);
+        filled
+    }
+}
+
+pub(super) fn counted<E>(inner: E) -> Counted<E> {
+    Counted {
+        inner,
+        attempts: Arc::new(AtomicUsize::new(0)),
+        fills: Arc::new(AtomicUsize::new(0)),
+    }
+}
+
+fn check_window<K: RadixKey>(input: Vec<K>, low: usize, width: usize) {
+    let mask = ((1u128 << width) - 1) << low;
+    let fixed = input[0].encode().to_u128() & !mask;
+    assert!(
+        input
+            .iter()
+            .all(|value| value.encode().to_u128() & !mask == fixed)
+    );
+    let mut expected: Vec<_> = input.iter().map(|value| value.encode()).collect();
+    expected.sort();
+    let mut actual = input.clone();
+    assert!(Direct.try_count_window(&mut actual, low, width));
+    assert!(actual.iter().map(|value| value.encode()).eq(expected));
+
+    // A fresh engine call must actually use the hook, not just return the
+    // correct output by taking a tile or an ordered-input early return.
+    let mut actual = input.clone();
+    let mut trace = counted(Direct);
+    sort_with_tile_bytes::<_, _, false>(&mut actual, &mut trace, None, 64);
+    assert_eq!(trace.fills.load(Relaxed), 1);
+    assert!(actual.windows(2).all(|w| w[0].encode() <= w[1].encode()));
+
+    let mut rows: Vec<_> = input
+        .into_iter()
+        .enumerate()
+        .map(|(id, key)| (key, id))
+        .collect();
+    let mut wanted = rows.clone();
+    wanted.sort_by_key(|row| row.0.encode());
+    let mut trace = counted(ByKey(|row: &(K, usize)| row.0));
+    sort_with_tile_bytes::<_, _, true>(&mut rows, &mut trace, None, 64);
+    assert!(trace.attempts.load(Relaxed) > 0);
+    assert_eq!(trace.fills.load(Relaxed), 0);
+    assert!(
+        rows.iter()
+            .map(|row| (row.0.encode(), row.1))
+            .eq(wanted.iter().map(|row| (row.0.encode(), row.1)))
+    );
+}
+
+#[test]
+fn narrow_count_all_integer_widths_and_reverse() {
+    let len = if cfg!(miri) { 129 } else { 1025 };
+    macro_rules! check {
+        ($($ty:ty),*) => {$(
+            let bits = core::mem::size_of::<$ty>() * 8;
+            for (low, width) in [(0, 3), (bits / 2, 4), (bits - 8, 8)] {
+                let mask = ((1u128 << width) - 1) << low;
+                let base = 0x9a31_65f0_c07b_12e4_a97c_d4e5_83f6_b2d1u128 & !mask;
+                let input: Vec<$ty> = (0..len)
+                    .map(|id| (base | (((id as u128).wrapping_mul(181) << low) & mask)) as $ty)
+                    .collect();
+                check_window(input.clone(), low, width);
+                check_window(input.into_iter().map(Reverse).collect(), low, width);
+            }
+        )*};
+    }
+    check!(
+        u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, i128, isize
+    );
+}
+
+#[test]
+fn narrow_count_float_bits_preserve_nan_payloads_and_signs() {
+    let len = if cfg!(miri) { 129 } else { 1025 };
+    // Keep the sign fixed: flipping it would complement every encoded bit and
+    // violate the small-window precondition. These groups cover each sign,
+    // NaN payloads, infinities, zeros/subnormals and exponent-only variation.
+    for sign in [0u32, 1 << 31] {
+        for (base, low) in [(0x7fc0_0000, 0), (0x7f80_0000, 0), (0, 0), (0, 23)] {
+            let input: Vec<_> = (0..len)
+                .map(|id| {
+                    f32::from_bits(sign | base | (((id as u32).wrapping_mul(181) & 255) << low))
+                })
+                .collect();
+            check_window(input.clone(), low, 8);
+            check_window(input.into_iter().map(Reverse).collect(), low, 8);
+        }
+    }
+    for sign in [0u64, 1 << 63] {
+        for (base, low) in [
+            (0x7ff8_0000_0000_0000, 0),
+            (0x7ff0_0000_0000_0000, 0),
+            (0, 0),
+            (0, 52),
+        ] {
+            let input: Vec<_> = (0..len)
+                .map(|id| {
+                    f64::from_bits(sign | base | (((id as u64).wrapping_mul(181) & 255) << low))
+                })
+                .collect();
+            check_window(input.clone(), low, 8);
+            check_window(input.into_iter().map(Reverse).collect(), low, 8);
+        }
+    }
+}
+
+#[test]
+fn narrow_count_declines_invalid_width_without_touching_records() {
+    for width in [0, 9, 64] {
+        let mut values = [3u64, 1, 2];
+        assert!(!Direct.try_count_window(&mut values, 0, width));
+        assert_eq!(values, [3, 1, 2]);
+    }
+    assert!(Direct.try_count_window(&mut [] as &mut [u128], 64, 8));
+}

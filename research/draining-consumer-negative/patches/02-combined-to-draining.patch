+/// Reserve only an ID: a scheduler unwind cannot drop a captured user key.
+fn launch_drain<'scope, T: Send + 'scope, E: Extract<T> + Send + 'scope, const CACHED: bool>(
+    scope: &rayon::Scope<'scope>,
+    queue: &'scope DrainQueue<T, E>,
+    candidate: u128,
+    tile_bytes: usize,
+) {
+    let id = {
+        let mut state = queue.lock();
+        if queue.failed.load(std::sync::atomic::Ordering::Acquire) || state.batches.is_empty() {
+            None
+        } else {
+            state.idle.pop()
+        }
+    };
+    if let Some(id) = id {
+        #[cfg(test)]
+        let hooks = crate::test_witness::current();
+        scope.spawn(move |_| {
+            #[cfg(test)]
+            let _consumer_witness = crate::test_witness::PhaseGuard::consumer(hooks);
+            drain_queue::<T, E, CACHED>(queue, id, candidate, tile_bytes);
+        });
+    }
+}

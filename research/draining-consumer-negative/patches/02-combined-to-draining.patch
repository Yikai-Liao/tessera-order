+#[test]
+#[cfg(not(miri))]
+fn simultaneous_payloads_wait_for_join() {
+    use std::sync::atomic::AtomicBool;
+    struct Payload {
+        probe: Arc<Probe>,
+        hooks: Arc<crate::test_witness::Hooks>,
+        drops: Arc<AtomicUsize>,
+    }
+    impl Drop for Payload {
+        fn drop(&mut self) {
+            crate::test_witness::assert_user_allowed();
+            assert!(self.probe.root_finished.load(SeqCst));
+            assert_eq!(
+                self.hooks.consumers_started.load(SeqCst),
+                self.hooks.consumers_done.load(SeqCst)
+            );
+            self.drops.fetch_add(1, SeqCst);
+        }
+    }
+    for workers in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap()
+            .install(|| {
+                let hooks = Arc::new(crate::test_witness::Hooks::default());
+                let child_failed =
+                    Arc::new((std::sync::Mutex::new(false), std::sync::Condvar::new()));
+                let producer_failed = Arc::new(AtomicBool::new(false));
+                let drops = Arc::new(AtomicUsize::new(0));
+                let probe = Arc::new_cyclic(|weak: &std::sync::Weak<Probe>| {
+                    let weak = weak.clone();
+                    let hooks = hooks.clone();
+                    let child_failed = child_failed.clone();
+                    let producer_failed = producer_failed.clone();
+                    let drops = drops.clone();
+                    Probe {
+                        callback: Some(Box::new(move || {
+                            if hooks.publication_count.load(SeqCst) == 0
+                                || producer_failed.load(SeqCst)
+                            {
+                                return;
+                            }
+                            let (lock, ready) = &*child_failed;
+                            let (guard, timeout) = ready
+                                .wait_timeout_while(
+                                    lock.lock().unwrap(),
+                                    std::time::Duration::from_secs(10),
+                                    |failed| !*failed,
+                                )
+                                .unwrap();
+                            assert!(!timeout.timed_out(), "child did not reach moved-key panic");
+                            drop(guard);
+                            producer_failed.store(true, SeqCst);
+                            std::panic::panic_any(Payload {
+                                probe: weak.upgrade().unwrap(),
+                                hooks: hooks.clone(),
+                                drops: drops.clone(),
+                            });
+                        })),
+                        ..Probe::default()
+                    }
+                });
+                let mut values: Vec<_> = (0..262_145u64)
+                    .map(|i| (i.wrapping_mul(0x9e3779b97f4a7c15), i.to_string()))
+                    .collect();
+                let mut expected = values.clone();
+                expected.sort_by_key(|row| row.0);
+                let result = crate::unwind::catch(|| {
+                    with_probe(probe.clone(), || {
+                        crate::test_witness::with_hooks(hooks.clone(), || {
+                            crate::par_stable_sort_by_key(&mut values, |row| {
+                                crate::test_witness::assert_user_allowed();
+                                if crate::test_witness::phase()
+                                    == crate::test_witness::Phase::Consumer
+                                    && crate::test_witness::has_moved()
+                                {
+                                    let (lock, ready) = &*child_failed;
+                                    let mut failed = lock.lock().unwrap();
+                                    if !*failed {
+                                        *failed = true;
+                                        ready.notify_all();
+                                        drop(failed);
+                                        std::panic::panic_any(Payload {
+                                            probe: probe.clone(),
+                                            hooks: hooks.clone(),
+                                            drops: drops.clone(),
+                                        });
+                                    }
+                                }
+                                row.0
+                            })
+                        });
+                    })
+                });
+                assert!(result.is_err());
+                assert!(producer_failed.load(SeqCst));
+                assert!(*child_failed.0.lock().unwrap());
+                drop(result);
+                assert_eq!(drops.load(SeqCst), 2);
+                values.sort_by_key(|row| row.0);
+                assert_eq!(values, expected);
+            });
+    }
+}

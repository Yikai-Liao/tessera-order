+#[test]
+#[cfg(not(miri))]
+fn public_owned_and_exclusive_stable() {
+    use std::cell::Cell;
+    for workers in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap()
+            .install(|| {
+                let mut owned: Vec<_> = (0..65_537usize)
+                    .map(|i| {
+                        (
+                            ((i.wrapping_mul(7919) % 4096) as u64),
+                            i.to_string(),
+                            Cell::new(i),
+                        )
+                    })
+                    .collect();
+                let mut expected: Vec<_> = owned.iter().map(|r| (r.0, r.2.get())).collect();
+                expected.sort_by_key(|r| r.0);
+                crate::par_stable_sort_by_key(&mut owned, |r| {
+                    crate::test_witness::assert_user_allowed();
+                    r.0
+                });
+                assert_eq!(
+                    owned.iter().map(|r| (r.0, r.2.get())).collect::<Vec<_>>(),
+                    expected
+                );
+                assert!(owned.iter().all(|r| r.1 == r.2.get().to_string()));
+
+                let mut cells: Vec<_> = (0..131_073usize).map(Cell::new).collect();
+                let mut exclusive: Vec<_> = cells
+                    .iter_mut()
+                    .map(|cell| ((cell.get().wrapping_mul(7919) % 4096) as u64, cell))
+                    .collect();
+                let mut expected: Vec<_> = exclusive.iter().map(|r| (r.0, r.1.get())).collect();
+                expected.sort_by_key(|r| r.0);
+                crate::par_stable_sort_by_key(&mut exclusive, |r| {
+                    crate::test_witness::assert_user_allowed();
+                    r.0
+                });
+                assert_eq!(
+                    exclusive
+                        .iter()
+                        .map(|r| (r.0, r.1.get()))
+                        .collect::<Vec<_>>(),
+                    expected
+                );
+            });
+    }
+}

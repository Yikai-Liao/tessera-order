+// Per-producer test controls do not alter production thresholds or kernels.
+thread_local! {
+    static PROBE: std::cell::RefCell<Option<Arc<Probe>>> = const { std::cell::RefCell::new(None) };
+}
+#[derive(Default)]
+struct Probe {
+    batch_bytes: Option<usize>,
+    root_finished: std::sync::atomic::AtomicBool,
+    callback: Option<Box<dyn Fn() + Send + Sync>>,
+}
+fn with_probe<R>(probe: Arc<Probe>, run: impl FnOnce() -> R) -> R {
+    struct Reset(Option<Arc<Probe>>);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            PROBE.with(|slot| {
+                slot.replace(self.0.take());
+            });
+        }
+    }
+    let _reset = Reset(PROBE.with(|slot| slot.replace(Some(probe))));
+    run()
+}
+pub(super) fn batch_bytes(default: usize) -> usize {
+    PROBE.with(|slot| {
+        slot.borrow()
+            .as_ref()
+            .and_then(|probe| probe.batch_bytes)
+            .unwrap_or(default)
+    })
+}
+pub(super) fn after_callback() {
+    let probe = PROBE.with(|slot| slot.borrow().clone());
+    if let Some(probe) = probe {
+        if let Some(callback) = &probe.callback {
+            callback();
+        }
+    }
+}
+pub(super) fn root_finished() {
+    PROBE.with(|slot| {
+        if let Some(probe) = slot.borrow().as_ref() {
+            probe.root_finished.store(true, SeqCst);
+        }
+    });
+}

+#[test]
+fn scoped_drain_reuses_exclusive_buckets() {
+    use std::cell::Cell;
+    struct CellKey;
+    impl Extract<(u64, &mut Cell<usize>)> for CellKey {
+        type Value = u64;
+        fn key(&mut self, record: &(u64, &mut Cell<usize>)) -> u64 {
+            crate::test_witness::assert_user_allowed();
+            record.0
+        }
+    }
+    let mut cells: Vec<_> = (0..128usize).map(Cell::new).collect();
+    let mut records: Vec<_> = cells
+        .iter_mut()
+        .map(|cell| ((cell.get() * 73 % 7) as u64, cell))
+        .collect();
+    let mut expected: Vec<_> = records.iter().map(|row| (row.0, row.1.get())).collect();
+    for child in expected.chunks_mut(8) {
+        child.sort_by_key(|row| row.0);
+    }
+    let queue = DrainQueue::new(2, 16);
+    for id in 0..2 {
+        queue.lock().bundles[id].as_mut().unwrap().key = Some(CellKey);
+        queue.lock().idle.push(id);
+    }
+    let mut batch = Vec::with_capacity(16);
+    for child in records.chunks_mut(8) {
+        batch.push(Materialized {
+            pointer: child.as_mut_ptr(),
+            len: child.len(),
+        });
+        queue.publish(&mut batch);
+        let id = queue.lock().idle.pop().unwrap();
+        // The scheduling adapter alone differs from Rayon. The same state,
+        // exact-pointer conversion, sort, empty-return and resource reuse run.
+        std::thread::scope(|scope| {
+            let queue = &queue;
+            scope
+                .spawn(move || drain_queue::<_, _, true>(queue, id, u128::MAX, TILE_BYTES))
+                .join()
+                .unwrap();
+        });
+        assert_eq!(queue.lock().idle.len(), 2);
+    }
+    assert_eq!(queue.published.load(SeqCst), 16);
+    assert_eq!(queue.consumed.load(SeqCst), 16);
+    assert_eq!(
+        records
+            .iter()
+            .map(|row| (row.0, row.1.get()))
+            .collect::<Vec<_>>(),
+        expected
+    );
+}

+#[test]
+#[cfg(not(miri))]
+fn threshold_clone_phase_preserved() {
+    struct CloningKey {
+        clones: Arc<AtomicUsize>,
+        panic_at: usize,
+        reenter_at: usize,
+        reentered: Arc<AtomicUsize>,
+        root_clones: usize,
+        consumer_copy: bool,
+        probe: Arc<Probe>,
+        hooks: Arc<crate::test_witness::Hooks>,
+        consumer_drops: Arc<AtomicUsize>,
+    }
+    impl Drop for CloningKey {
+        fn drop(&mut self) {
+            if self.consumer_copy {
+                crate::test_witness::assert_user_allowed();
+                assert!(self.probe.root_finished.load(SeqCst));
+                assert_eq!(
+                    self.hooks.consumers_started.load(SeqCst),
+                    self.hooks.consumers_done.load(SeqCst)
+                );
+                self.consumer_drops.fetch_add(1, SeqCst);
+            }
+        }
+    }
+    impl Clone for CloningKey {
+        fn clone(&self) -> Self {
+            crate::test_witness::assert_user_allowed();
+            let count = self.clones.fetch_add(1, SeqCst) + 1;
+            if count == self.reenter_at {
+                rayon::join(
+                    || {
+                        let mut inner: Vec<_> = (0..131_073u64)
+                            .map(|i| i.wrapping_mul(0x9e3779b97f4a7c15))
+                            .collect();
+                        crate::par_stable_sort(&mut inner);
+                        assert!(inner.is_sorted());
+                    },
+                    || (),
+                );
+                self.reentered.fetch_add(1, SeqCst);
+            }
+            if count == self.panic_at {
+                panic!("first-threshold clone panic");
+            }
+            Self {
+                clones: self.clones.clone(),
+                panic_at: self.panic_at,
+                reenter_at: self.reenter_at,
+                reentered: self.reentered.clone(),
+                root_clones: self.root_clones,
+                consumer_copy: count > self.root_clones,
+                probe: self.probe.clone(),
+                hooks: self.hooks.clone(),
+                consumer_drops: self.consumer_drops.clone(),
+            }
+        }
+    }
+    impl Extract<u64> for CloningKey {
+        type Value = u64;
+        fn key(&mut self, record: &u64) -> u64 {
+            crate::test_witness::assert_user_allowed();
+            *record
+        }
+    }
+    for workers in [2, 3, 4] {
+        for mode in 0..4 {
+            // P2 has only one child clone, so no later child clone can fail.
+            if mode == 3 && workers == 2 {
+                continue;
+            }
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap()
+                .install(|| {
+                    let hooks = Arc::new(crate::test_witness::Hooks::default());
+                    let probe = Arc::new(Probe {
+                        batch_bytes: if mode == 0 { Some(usize::MAX) } else { None },
+                        ..Probe::default()
+                    });
+                    let clones = Arc::new(AtomicUsize::new(0));
+                    let reentered = Arc::new(AtomicUsize::new(0));
+                    let consumer_drops = Arc::new(AtomicUsize::new(0));
+                    let mut values: Vec<_> = (0..131_073u64)
+                        .map(|i| i.wrapping_mul(0x9e3779b97f4a7c15))
+                        .collect();
+                    let mut expected = values.clone();
+                    expected.sort();
+                    let result = crate::unwind::catch(|| {
+                        with_probe(probe.clone(), || {
+                            crate::test_witness::with_hooks(hooks.clone(), || {
+                                sort::<_, _, false>(
+                                    &mut values,
+                                    CloningKey {
+                                        clones: clones.clone(),
+                                        panic_at: match mode {
+                                            2 => workers + 2,
+                                            3 => workers + 3,
+                                            _ => usize::MAX,
+                                        },
+                                        reenter_at: if mode == 1 {
+                                            workers + 2
+                                        } else {
+                                            usize::MAX
+                                        },
+                                        reentered: reentered.clone(),
+                                        root_clones: workers + 1,
+                                        consumer_copy: false,
+                                        probe: probe.clone(),
+                                        hooks: hooks.clone(),
+                                        consumer_drops: consumer_drops.clone(),
+                                    },
+                                )
+                            });
+                        })
+                    });
+                    assert_eq!(result.is_err(), mode >= 2);
+                    assert!(probe.root_finished.load(SeqCst));
+                    assert_eq!(hooks.root_geometry.lock().unwrap()[0].3, workers);
+                    if mode == 0 {
+                        assert_eq!(clones.load(SeqCst), workers + 1);
+                        assert_eq!(hooks.consumers_started.load(SeqCst), 0);
+                    } else if mode == 1 {
+                        assert_eq!(clones.load(SeqCst), workers * 2);
+                        assert_eq!(reentered.load(SeqCst), 1);
+                        assert!(hooks.consumers_started.load(SeqCst) > 0);
+                    } else {
+                        assert_eq!(clones.load(SeqCst), workers + mode);
+                        assert_eq!(hooks.consumers_started.load(SeqCst), 0);
+                    }
+                    assert_eq!(
+                        consumer_drops.load(SeqCst),
+                        match mode {
+                            1 => workers - 1,
+                            3 => 1,
+                            _ => 0,
+                        }
+                    );
+                    if mode >= 2 {
+                        values.sort();
+                    }
+                    assert_eq!(values, expected);
+                });
+        }
+    }
+}

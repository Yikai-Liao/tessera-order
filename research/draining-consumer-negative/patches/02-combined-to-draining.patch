+#[test]
+#[cfg(not(miri))]
+fn nested_keys_keep_bundle_bound() {
+    struct ReentrantKey {
+        entered: bool,
+        active: Arc<AtomicUsize>,
+        maximum: Arc<AtomicUsize>,
+    }
+    impl Extract<u64> for ReentrantKey {
+        type Value = u64;
+        fn key(&mut self, record: &u64) -> u64 {
+            crate::test_witness::assert_user_allowed();
+            if !self.entered {
+                self.entered = true;
+                let active = self.active.fetch_add(1, SeqCst) + 1;
+                self.maximum.fetch_max(active, SeqCst);
+                // This bundle remains charged while its task is suspended in
+                // real Rayon work and a nested public parallel sort.
+                rayon::join(
+                    || {
+                        let mut inner: Vec<_> = (0..131_073u64)
+                            .map(|i| i.wrapping_mul(0x9e3779b97f4a7c15))
+                            .collect();
+                        crate::par_stable_sort(&mut inner);
+                        assert!(inner.is_sorted());
+                    },
+                    || {
+                        rayon::yield_now();
+                    },
+                );
+                self.active.fetch_sub(1, SeqCst);
+            }
+            *record
+        }
+    }
+    for workers in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap()
+            .install(|| {
+                let active = Arc::new(AtomicUsize::new(0));
+                let maximum = Arc::new(AtomicUsize::new(0));
+                let queue = DrainQueue::new(workers, 256);
+                for id in 0..workers {
+                    queue.lock().bundles[id].as_mut().unwrap().key = Some(ReentrantKey {
+                        entered: false,
+                        active: active.clone(),
+                        maximum: maximum.clone(),
+                    });
+                    queue.lock().idle.push(id);
+                }
+                let mut values: Vec<_> = (0..65_536u64).map(|i| (i * 73) % 1024).collect();
+                let mut expected = values.clone();
+                for child in expected.chunks_mut(2048) {
+                    child.sort();
+                }
+                let mut batch = Vec::with_capacity(256);
+                rayon::scope(|scope| {
+                    for child in values.chunks_mut(2048) {
+                        batch.push(Materialized {
+                            pointer: child.as_mut_ptr(),
+                            len: child.len(),
+                        });
+                        queue.publish(&mut batch);
+                        launch_drain::<_, _, false>(scope, &queue, u128::MAX, TILE_BYTES);
+                    }
+                });
+                assert_eq!(values, expected);
+                assert_eq!(active.load(SeqCst), 0);
+                assert!((1..=workers).contains(&maximum.load(SeqCst)));
+                let state = queue.lock();
+                assert_eq!(state.bundles.len(), workers);
+                assert_eq!(state.idle.len(), workers);
+                assert!(state.batches.is_empty());
+                assert!(state.panics.iter().all(Option::is_none));
+            });
+    }
+}

+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Scheduler-specific witnesses, independent of fixed-consumer rendezvous.
+
+use super::*;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering::SeqCst};
+
+/// Counts extractor work independently of scheduler metadata accounting.
+#[derive(Clone)]
+struct CountKeys(Arc<AtomicUsize>);
+impl Extract<u64> for CountKeys {
+    type Value = u64;
+    fn key(&mut self, record: &u64) -> u64 {
+        crate::test_witness::assert_user_allowed();
+        self.0.fetch_add(1, SeqCst);
+        *record
+    }
+}
+
+#[test]
+#[cfg(not(miri))]
+fn empty_publish_race_drains() {
+    for workers in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap()
+            .install(|| {
+                let calls = Arc::new(AtomicUsize::new(0));
+                let queue = DrainQueue::new(workers, 256);
+                for id in 0..workers {
+                    queue.lock().bundles[id].as_mut().unwrap().key = Some(CountKeys(calls.clone()));
+                    queue.lock().idle.push(id);
+                }
+                let mut values = vec![0u64; 512];
+                let mut batch = Vec::with_capacity(256);
+                rayon::scope(|scope| {
+                    for (index, child) in values.chunks_mut(2).enumerate() {
+                        child.copy_from_slice(&[1, 0]);
+                        batch.push(Materialized {
+                            pointer: child.as_mut_ptr(),
+                            len: child.len(),
+                        });
+                        queue.publish(&mut batch);
+                        launch_drain::<_, _, false>(scope, &queue, u128::MAX, TILE_BYTES);
+                        // Force many empty/refill opportunities, without any
+                        // barrier requiring a particular thread to make progress.
+                        if index % 2 == 0 {
+                            rayon::yield_now();
+                        }
+                    }
+                });
+                let state = queue.lock();
+                assert!(state.batches.is_empty());
+                assert!(state.buckets.is_empty());
+                assert_eq!(state.bundles.len(), workers);
+                assert_eq!(state.idle.len(), workers);
+                assert!(state.bundles.iter().all(Option::is_some));
+                assert!(state.panics.iter().all(Option::is_none));
+                drop(state);
+                assert_eq!(queue.published.load(SeqCst), 256);
+                assert_eq!(queue.consumed.load(SeqCst), 256);
+                assert!(calls.load(SeqCst) > 0);
+                assert!(values.chunks(2).all(|child| child == [0, 1]));
+            });
+    }
+}

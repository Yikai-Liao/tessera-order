+#[test]
+#[cfg(not(miri))]
+fn moved_panic_retains_payload() {
+    use std::sync::atomic::AtomicBool;
+    struct Payload {
+        joined: Arc<AtomicBool>,
+        dropped: Arc<AtomicUsize>,
+    }
+    impl Drop for Payload {
+        fn drop(&mut self) {
+            assert!(self.joined.load(SeqCst), "payload dropped before join");
+            self.dropped.fetch_add(1, SeqCst);
+        }
+    }
+    struct FailingKey {
+        joined: Arc<AtomicBool>,
+        dropped: Arc<AtomicUsize>,
+        fired: Arc<AtomicBool>,
+    }
+    impl Extract<(u64, String)> for FailingKey {
+        type Value = u64;
+        fn key(&mut self, record: &(u64, String)) -> u64 {
+            crate::test_witness::assert_user_allowed();
+            if crate::test_witness::has_moved() && !self.fired.swap(true, SeqCst) {
+                std::panic::panic_any(Payload {
+                    joined: self.joined.clone(),
+                    dropped: self.dropped.clone(),
+                });
+            }
+            record.0
+        }
+    }
+    impl Drop for FailingKey {
+        fn drop(&mut self) {
+            assert!(self.joined.load(SeqCst), "key dropped before join");
+        }
+    }
+    for workers in [2, 3, 4] {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap()
+            .install(|| {
+                let joined = Arc::new(AtomicBool::new(false));
+                let dropped = Arc::new(AtomicUsize::new(0));
+                let fired = Arc::new(AtomicBool::new(false));
+                let queue = DrainQueue::new(workers, 256);
+                for id in 0..workers {
+                    queue.lock().bundles[id].as_mut().unwrap().key = Some(FailingKey {
+                        joined: joined.clone(),
+                        dropped: dropped.clone(),
+                        fired: fired.clone(),
+                    });
+                    queue.lock().idle.push(id);
+                }
+                let mut values: Vec<_> = (0..65_537u64)
+                    .map(|i| (i.wrapping_mul(0x9e3779b97f4a7c15), i.to_string()))
+                    .collect();
+                let mut expected = values.clone();
+                expected.sort_by_key(|row| row.0);
+                let mut batch = vec![Materialized {
+                    pointer: values.as_mut_ptr(),
+                    len: values.len(),
+                }];
+                rayon::scope(|scope| {
+                    queue.publish(&mut batch);
+                    launch_drain::<_, _, true>(scope, &queue, u128::MAX, TILE_BYTES);
+                });
+                // This fixture proves child guard recovery and scheduler retention;
+                // simultaneous root failure needs a separate public-entry witness.
+                joined.store(true, SeqCst);
+                assert!(fired.load(SeqCst), "fixture did not reach moved-key panic");
+                assert!(queue.failed.load(SeqCst));
+                assert_eq!(dropped.load(SeqCst), 0);
+                values.sort_by_key(|row| row.0);
+                assert_eq!(values, expected);
+                assert_eq!(
+                    queue
+                        .lock()
+                        .panics
+                        .iter()
+                        .filter(|slot| slot.is_some())
+                        .count(),
+                    1
+                );
+                drop(queue);
+                assert_eq!(dropped.load(SeqCst), 1);
+            });
+    }
+}

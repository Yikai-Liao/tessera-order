+/// One fixed child resource, retained even when its task returns or panics.
+struct DrainBundle<T, E> {
+    key: Option<E>,
+    workspace: Workspace<T>,
+    buckets: Vec<Materialized<T>>,
+}
+
+/// Metadata and idle-resource transitions share a lock, never user callbacks.
+struct DrainState<T, E> {
+    buckets: std::collections::VecDeque<Materialized<T>>,
+    batches: std::collections::VecDeque<usize>,
+    bundles: Vec<Option<DrainBundle<T, E>>>,
+    idle: Vec<usize>,
+    panics: Vec<Option<crate::unwind::Payload>>,
+}
+
+/// A bounded, drain-to-empty queue; no task waits for future publication.
+struct DrainQueue<T, E> {
+    state: std::sync::Mutex<DrainState<T, E>>,
+    failed: std::sync::atomic::AtomicBool,
+    #[cfg(test)]
+    published: std::sync::atomic::AtomicUsize,
+    #[cfg(test)]
+    consumed: std::sync::atomic::AtomicUsize,
+}
+
+impl<T, E> DrainQueue<T, E> {
+    fn new(count: usize, radix: usize) -> Self {
+        Self {
+            state: std::sync::Mutex::new(DrainState {
+                buckets: std::collections::VecDeque::with_capacity(radix),
+                batches: std::collections::VecDeque::with_capacity(radix),
+                bundles: (0..count)
+                    .map(|_| {
+                        Some(DrainBundle {
+                            key: None,
+                            workspace: Workspace::new(),
+                            buckets: Vec::with_capacity(radix),
+                        })
+                    })
+                    .collect(),
+                idle: Vec::with_capacity(count),
+                panics: (0..count).map(|_| None).collect(),
+            }),
+            failed: std::sync::atomic::AtomicBool::new(false),
+            #[cfg(test)]
+            published: std::sync::atomic::AtomicUsize::new(0),
+            #[cfg(test)]
+            consumed: std::sync::atomic::AtomicUsize::new(0),
+        }
+    }
+
+    fn lock(&self) -> DrainLock<'_, T, E> {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        #[cfg(test)]
+        {
+            DrainLock {
+                state,
+                _witness: crate::test_witness::QueueGuard::new(),
+            }
+        }
+        #[cfg(not(test))]
+        {
+            state
+        }
+    }
+
+    fn publish(&self, buckets: &mut Vec<Materialized<T>>) {
+        let mut state = self.lock();
+        if !self.failed.load(std::sync::atomic::Ordering::Acquire) {
+            #[cfg(test)]
+            self.published
+                .fetch_add(buckets.len(), std::sync::atomic::Ordering::Relaxed);
+            state.batches.push_back(buckets.len());
+            state.buckets.extend(buckets.drain(..));
+        }
+    }
+}

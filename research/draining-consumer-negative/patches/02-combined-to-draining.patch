+#[test]
+fn scoped_drain_retains_panic() {
+    use std::sync::atomic::AtomicBool;
+    struct Payload(Arc<AtomicBool>, Arc<AtomicUsize>);
+    impl Drop for Payload {
+        fn drop(&mut self) {
+            crate::test_witness::assert_user_allowed();
+            assert!(self.0.load(SeqCst));
+            self.1.fetch_add(1, SeqCst);
+        }
+    }
+    struct Key(Arc<AtomicBool>, Arc<AtomicUsize>);
+    impl Extract<(u64, String)> for Key {
+        type Value = u64;
+        fn key(&mut self, _: &(u64, String)) -> u64 {
+            crate::test_witness::assert_user_allowed();
+            std::panic::panic_any(Payload(self.0.clone(), self.1.clone()));
+        }
+    }
+    let joined = Arc::new(AtomicBool::new(false));
+    let drops = Arc::new(AtomicUsize::new(0));
+    let queue = DrainQueue::new(1, 2);
+    queue.lock().bundles[0].as_mut().unwrap().key = Some(Key(joined.clone(), drops.clone()));
+    let mut records: Vec<_> = (0..19u64).map(|id| (id * 73 % 7, id.to_string())).collect();
+    let expected = records.clone();
+    let mut batch = vec![Materialized {
+        pointer: records.as_mut_ptr(),
+        len: records.len(),
+    }];
+    queue.publish(&mut batch);
+    std::thread::scope(|scope| {
+        let queue = &queue;
+        scope
+            .spawn(move || drain_queue::<_, _, true>(queue, 0, u128::MAX, TILE_BYTES))
+            .join()
+            .unwrap();
+    });
+    joined.store(true, SeqCst);
+    assert!(queue.failed.load(SeqCst));
+    assert_eq!(drops.load(SeqCst), 0);
+    assert_eq!(records, expected);
+    drop(queue);
+    assert_eq!(drops.load(SeqCst), 1);
+}

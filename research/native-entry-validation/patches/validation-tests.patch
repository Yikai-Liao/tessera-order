+// SPDX-License-Identifier: BSD-2-Clause
+//! Exercise the widened zero-child-bit native root with real shards and recovery.
+use super::*;
+use crate::key::ByKey;
+use crate::test_witness::{self, Hooks};
+use std::cell::Cell;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering::SeqCst};
+
+const LEN: usize = 131_073;
+const VARYING: u128 = 0x103;
+
+fn sparse_key(id: usize) -> u64 {
+    let k = (id * 5) % 8;
+    ((k & 3) | ((k & 4) << 6)) as u64
+}
+
+fn run<T: Send, E: Extract<T, Value = u64> + Clone + Send>(
+    records: &mut [T],
+    key: E,
+    hooks: Arc<Hooks>,
+    fail: bool,
+) {
+    let digit = choose_split_digit(records, 9, 256, &mut key.clone());
+    assert_eq!((digit.width, digit.shift), (9, 0));
+    assert_eq!(VARYING & !digit.mask::<u64>().to_u128(), 0);
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap()
+            .install(|| {
+                test_witness::with_hooks(hooks.clone(), || {
+                    sort_prepared::<_, _, true>(records, key, VARYING, 256);
+                });
+            });
+    }));
+    assert_eq!(result.is_err(), fail);
+    let geometry = hooks.root_geometry.lock().unwrap();
+    assert_eq!(geometry.len(), 1, "native root was bypassed");
+    assert_eq!(geometry[0].0, LEN);
+    assert_eq!(geometry[0].1, 512);
+    assert!(
+        geometry[0].3 >= 2,
+        "serial partition is not a route witness"
+    );
+    assert_eq!(hooks.root_key_panic.load(SeqCst), fail);
+    assert!(hooks.root_calls.load(SeqCst) > 0);
+}
+
+#[test]
+fn sparse_owned_recovers_stably() {
+    struct Row {
+        value: Cell<(u64, usize)>,
+        payload: String,
+        drops: Arc<Vec<AtomicUsize>>,
+    }
+    impl Drop for Row {
+        fn drop(&mut self) {
+            let id = self.value.get().1;
+            assert_eq!(self.payload, id.to_string());
+            assert_eq!(self.drops[id].fetch_add(1, SeqCst), 0);
+        }
+    }
+    for fail in [false, true] {
+        let drops = Arc::new((0..LEN).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+        let mut records: Vec<_> = (0..LEN)
+            .map(|id| Row {
+                value: Cell::new((sparse_key(id), id)),
+                payload: id.to_string(),
+                drops: drops.clone(),
+            })
+            .collect();
+        let hooks = Arc::new(Hooks::default());
+        let extract_hooks = hooks.clone();
+        run(
+            &mut records,
+            ByKey(move |row: &Row| {
+                extract_hooks.key(false, fail);
+                row.value.get().0
+            }),
+            hooks,
+            fail,
+        );
+        let actual: Vec<_> = records.iter().map(|row| row.value.get()).collect();
+        let mut expected: Vec<_> = (0..LEN).map(|id| (sparse_key(id), id)).collect();
+        expected.sort_by_key(|row| row.0);
+        if !fail {
+            assert_eq!(actual, expected);
+        }
+        let mut ids: Vec<_> = actual.iter().map(|row| row.1).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..LEN).collect::<Vec<_>>());
+        assert!(drops.iter().all(|n| n.load(SeqCst) == 0));
+        drop(records);
+        assert!(drops.iter().all(|n| n.load(SeqCst) == 1));
+    }
+}
+
+#[test]
+fn sparse_exclusive_recovers_borrows() {
+    for fail in [false, true] {
+        let mut backing: Vec<_> = (0..LEN).map(|id| Cell::new((sparse_key(id), id))).collect();
+        let mut records: Vec<_> = backing.iter_mut().collect();
+        let hooks = Arc::new(Hooks::default());
+        let extract_hooks = hooks.clone();
+        run(
+            &mut records,
+            ByKey(move |row: &&mut Cell<(u64, usize)>| {
+                extract_hooks.key(false, fail);
+                row.get().0
+            }),
+            hooks,
+            fail,
+        );
+        let actual: Vec<_> = records.iter().map(|row| row.get()).collect();
+        let mut expected: Vec<_> = (0..LEN).map(|id| (sparse_key(id), id)).collect();
+        expected.sort_by_key(|row| row.0);
+        if !fail {
+            assert_eq!(actual, expected);
+        }
+        let mut ids: Vec<_> = actual.iter().map(|row| row.1).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..LEN).collect::<Vec<_>>());
+        for row in records {
+            let (key, id) = row.get();
+            row.set((key + 1000, id));
+        }
+        assert!(
+            backing
+                .iter()
+                .enumerate()
+                .all(|(id, row)| row.get() == (sparse_key(id) + 1000, id))
+        );
+    }
+}

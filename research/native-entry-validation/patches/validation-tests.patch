+// SPDX-License-Identifier: BSD-2-Clause
+//! Payload identities witness stability, unlike unique random-key timing inputs.
+#![cfg(all(feature = "rayon", not(miri)))]
+use std::cmp::Reverse;
+use tessera_sort::par_stable_sort_by_key;
+
+#[test]
+fn duplicate_widths_preserve_payloads() {
+    for threads in [1, 2, 4, 8] {
+        rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap().install(|| {
+            macro_rules! check {
+                ($($ty:ty),*) => {$(
+                    let len = 1024 * 1024 / size_of::<($ty, usize)>() + 1;
+                    let mut rows: Vec<_> = (0..len).map(|id| {
+                        let key = ((id % 513) as u128).wrapping_mul(0x9e3779b97f4a7c15_94d049bb133111eb) as $ty;
+                        (key, id)
+                    }).collect();
+                    let mut expected = rows.clone();
+                    expected.sort_by_key(|row| row.0);
+                    par_stable_sort_by_key(&mut rows, |row| row.0);
+                    assert_eq!(rows, expected);
+                    // Restore original payload order before checking reverse stability.
+                    rows.sort_by_key(|row| row.1);
+                    expected = rows.clone();
+                    expected.sort_by_key(|row| Reverse(row.0));
+                    par_stable_sort_by_key(&mut rows, |row| Reverse(row.0));
+                    assert_eq!(rows, expected);
+                )*};
+            }
+            check!(u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, i128, isize);
+        });
+    }
+}

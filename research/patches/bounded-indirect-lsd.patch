+#[test]
+fn retained_accounting_includes_old_payload_and_probe_scratch() {
+    let mut workspace = Workspace::<Row<u64>>::new();
+    workspace.tile.resize_with(900, MaybeUninit::uninit);
+    workspace.probe.resize_with(2048, MaybeUninit::uninit);
+    let old_payload = workspace.tile.capacity() * size_of::<Row<u64>>();
+    let old_probe = workspace.probe.capacity() * size_of::<u128>();
+    let old = workspace.retained_bytes();

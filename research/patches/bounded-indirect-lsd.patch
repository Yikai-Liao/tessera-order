+#[cfg(feature = "indirect-tiles")]
+#[test]
+fn indirect_metadata_is_reported_and_warm_workspace_reuses_it() {
+    #[derive(Clone)]
+    #[repr(C)]
+    struct Wide {
+        key: u64,
+        id: usize,
+        payload: [u8; 112],
+    }
+    let mut input: Vec<_> = (0..4097u64)
+        .map(|id| Wide {
+            key: id.wrapping_mul(0x9e3779b97f4a7c15),
+            id: id as usize,
+            payload: [id as u8; 112],
+        })
+        .collect();
+    let original = input.clone();
+    let mut workspace = Workspace::new();
+    let (_, bytes) = measure(|| workspace.stable_sort_by_key(&mut input, |row| row.key));
+    assert_eq!(workspace.retained_bytes() as isize, bytes);
+    assert!(input.is_sorted_by_key(|row| row.key));
+    assert!(input.iter().all(|row| row.payload == [row.id as u8; 112]));
+    input.clone_from_slice(&original);
+    let (allocations, bytes) = measure(|| workspace.stable_sort_by_key(&mut input, |row| row.key));
+    assert_eq!((allocations, bytes), (0, 0));
+    let retained = workspace.retained_bytes();
+    let (_, freed) = measure(|| workspace.shrink_to_fit());
+    assert_eq!(freed, -(retained as isize));
+    assert_eq!(workspace.retained_bytes(), 0);
+}

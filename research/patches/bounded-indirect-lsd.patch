+#[cfg(all(test, feature = "indirect-tiles"))]
+pub(crate) mod tile_metrics {
+    extern crate std;
+    use std::cell::Cell;
+
+    #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+    pub(crate) struct Metrics {
+        pub(crate) msd_tiles: usize,
+        pub(crate) lsd_tiles: usize,
+        pub(crate) planned_lsd_passes: usize,
+        pub(crate) counting_passes: usize,
+        pub(crate) scattered_records: usize,
+        pub(crate) copyback_records: usize,
+        pub(crate) insertion_swaps: usize,
+        pub(crate) capture_tiles: usize,
+        pub(crate) capture_active: bool,
+        pub(crate) indirect_tiles: usize,
+        pub(crate) index_passes: usize,
+        pub(crate) permutation_copies: usize,
+    }
+
+    std::thread_local! {
+        static COUNTS: Cell<Metrics> = Cell::new(Metrics::default());
+        static FORCE_LITERAL: Cell<bool> = const { Cell::new(false) };
+    }
+
+    fn update(f: impl FnOnce(&mut Metrics)) {
+        COUNTS.with(|counts| {
+            let mut value = counts.get();
+            f(&mut value);
+            counts.set(value);
+        });
+    }
+
+    pub(crate) fn reset(force_literal: bool) {
+        FORCE_LITERAL.with(|flag| flag.set(force_literal));
+        COUNTS.with(|counts| counts.set(Metrics::default()));
+    }
+
+    pub(crate) fn take() -> Metrics {
+        FORCE_LITERAL.with(|flag| flag.set(false));
+        COUNTS.with(|counts| counts.replace(Metrics::default()))
+    }
+
+    #[cfg(all(
+        feature = "indirect-tiles-32",
+        feature = "rayon",
+        target_pointer_width = "64"
+    ))]
+    pub(crate) fn snapshot() -> Metrics {
+        COUNTS.with(Cell::get)
+    }
+
+    pub(crate) struct CaptureGuard;
+
+    pub(crate) fn begin_capture() -> CaptureGuard {
+        update(|counts| {
+            counts.capture_tiles += 1;
+            counts.capture_active = true;
+        });
+        CaptureGuard
+    }
+
+    impl Drop for CaptureGuard {
+        fn drop(&mut self) {
+            update(|counts| counts.capture_active = false);
+        }
+    }
+
+    #[cfg(feature = "rayon")]
+    pub(crate) fn capture_active() -> bool {
+        COUNTS.with(|counts| counts.get().capture_active)
+    }
+
+    pub(crate) fn literal_forced() -> bool {
+        FORCE_LITERAL.with(Cell::get)
+    }
+
+    pub(crate) fn insertion_swap() {
+        update(|counts| counts.insertion_swaps += 1);
+    }
+
+    pub(crate) fn msd() {
+        update(|counts| counts.msd_tiles += 1);
+    }
+
+    pub(crate) fn lsd(passes: usize) {
+        update(|counts| {
+            counts.lsd_tiles += 1;
+            counts.planned_lsd_passes += passes;
+        });
+    }
+
+    pub(crate) fn counting_pass(len: usize) {
+        update(|counts| {
+            counts.counting_passes += 1;
+            counts.scattered_records += len;
+        });
+    }
+
+    pub(crate) fn copyback(len: usize) {
+        update(|counts| counts.copyback_records += len);
+    }
+
+    #[cfg(feature = "indirect-tiles")]
+    pub(crate) fn indirect(passes: usize, copies: usize) {
+        update(|counts| {
+            counts.indirect_tiles += 1;
+            counts.index_passes += passes;
+            counts.permutation_copies += copies;
+        });
+        // This hook runs only after materialize returned, with every record
+        // restored to its slice; identity maps must not witness a real move.
+        #[cfg(feature = "rayon")]
+        if copies != 0 {
+            crate::test_witness::indirect_completed();
+        }
+    }
+}

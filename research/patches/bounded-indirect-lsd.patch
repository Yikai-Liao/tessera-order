+// SPDX-License-Identifier: BSD-2-Clause
+
+use super::*;
+use crate::RadixKey;
+use crate::engine::{sort_tile_for_test, tile_metrics};
+use crate::key::ByKey;
+extern crate std;
+use alloc::string::{String, ToString};
+use alloc::vec;
+use core::cell::Cell;
+use core::cmp::Reverse;
+use core::mem::MaybeUninit;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Clone, Debug)]
+#[repr(C, align(8))]
+struct Row<K, const PAD: usize = 48> {
+    key: K,
+    id: usize,
+    payload: [u8; PAD],
+}
+
+fn rows<K: Copy, const PAD: usize>(keys: &[K]) -> Vec<Row<K, PAD>> {
+    keys.iter()
+        .enumerate()
+        .map(|(id, &key)| Row {
+            key,
+            id,
+            payload: [id as u8; PAD],
+        })
+        .collect()
+}
+
+fn mixed(index: usize) -> u64 {
+    let mut value = (index as u64).wrapping_add(0x9e3779b97f4a7c15);
+    value = (value ^ (value >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+    value = (value ^ (value >> 27)).wrapping_mul(0x94d049bb133111eb);
+    value ^ (value >> 31)
+}
+
+fn check_keys<K: RadixKey>(keys: &[K]) {
+    let mut records = rows::<K, 64>(keys);
+    let mut expected: Vec<_> = keys
+        .iter()
+        .enumerate()
+        .map(|(id, &key)| (key.encode(), id))
+        .collect();
+    expected.sort_by_key(|&(key, _)| key);
+    let mut workspace = Workspace::new();
+    let mut calls = 0;
+    let handled = try_sort(
+        &mut records,
+        &mut ByKey(|row: &Row<K, 64>| {
+            calls += 1;
+            row.key
+        }),
+        &mut workspace,
+    );
+    assert_eq!(handled, keys.len() >= 2);
+    assert_eq!(calls, if handled { keys.len() } else { 0 });
+    let actual: Vec<_> = records
+        .iter()
+        .map(|row| (row.key.encode(), row.id))
+        .collect();
+    assert!(actual == expected);
+    for row in records {
+        assert_eq!(row.payload, [row.id as u8; 64]);
+    }
+}
+
+#[test]
+fn empty_singleton_and_tile_boundaries() {
+    assert_eq!(size_of::<Row<u64>>(), 64);
+    for len in [0, 1, 2, 47, 48, 49, 1023, 1024, 1025] {
+        let keys: Vec<_> = (0..len).map(mixed).collect();
+        let mut records = rows::<_, 48>(&keys);
+        let mut workspace = Workspace::new();
+        let handled = try_sort(
+            &mut records,
+            &mut ByKey(|row: &Row<u64>| row.key),
+            &mut workspace,
+        );
+        assert_eq!(handled, (2..=1024).contains(&len));
+        if handled {
+            assert!(records.is_sorted_by_key(|row| row.key));
+        } else {
+            assert!(records.iter().map(|row| row.key).eq(keys));
+            assert_eq!(workspace.retained_bytes(), 0);
+        }
+    }
+    // Oversized narrow input is ineligible. With the 64 KiB and >=32-byte
+    // gates, the u16 limit is redundant defensive validation, not a separately
+    // reachable eligible boundary.
+    let mut narrow = vec![0u8; u16::MAX as usize + 1];
+    assert!(!try_sort(
+        &mut narrow,
+        &mut crate::key::Direct,
+        &mut Workspace::new()
+    ));
+    // A giant record does not cause a giant stack temporary or allocation here.
+    let mut huge: Vec<[u8; MAX_RECORD_BYTES + 1]> = Vec::new();
+    huge.resize_with(2, || [0; MAX_RECORD_BYTES + 1]);
+    let mut workspace = Workspace::new();
+    assert!(!try_sort(
+        &mut huge,
+        &mut ByKey(|row: &[u8; MAX_RECORD_BYTES + 1]| row[0]),
+        &mut workspace
+    ));
+    assert_eq!(workspace.retained_bytes(), 0);
+}
+
+#[test]
+fn index_lsd_stability_extremes_and_all_key_widths() {
+    check_keys::<u64>(&[]);
+    check_keys(&[u64::MAX]);
+    check_keys(&vec![u64::MAX; 257]);
+    check_keys(&(0..511).map(|i| mixed(i) % 3).collect::<Vec<_>>());
+    check_keys(&(0..511).map(mixed).collect::<Vec<_>>());
+    check_keys(
+        &(0..257)
+            .map(|i| ((mixed(i) as u128) << 64) | mixed(i + 1) as u128)
+            .collect::<Vec<_>>(),
+    );
+    check_keys(&[0u128, u128::MAX, 1 << 127, 0, u128::MAX, (1 << 64) + 1]);
+    check_keys(&[i128::MIN, -1, 0, i128::MAX, i128::MIN, 1]);
+    check_keys(&[
+        Reverse(i64::MIN),
+        Reverse(0),
+        Reverse(i64::MAX),
+        Reverse(-1),
+        Reverse(0),
+    ]);
+    check_keys(&[0u8, u8::MAX, 1, 0, 127]);
+    check_keys(&[0u16, u16::MAX, 1, 0, 256]);
+    check_keys(&[0u32, u32::MAX, 1, 0, 1 << 31]);
+    check_keys(&[0usize, usize::MAX, 1, 0, usize::MAX / 2]);
+}
+
+#[test]
+fn floats_use_encoded_nan_and_signed_zero_order() {
+    let bits = [
+        0xffff_ffff_ffff_ffff,
+        0xfff8_0000_0000_0001,
+        f64::NEG_INFINITY.to_bits(),
+        (-1f64).to_bits(),
+        (-0f64).to_bits(),
+        0f64.to_bits(),
+        1f64.to_bits(),
+        f64::INFINITY.to_bits(),
+        0x7ff0_0000_0000_0001,
+        0x7ff8_0000_0000_0001,
+        u64::MAX,
+    ];
+    let keys: Vec<_> = bits
+        .iter()
+        .rev()
+        .chain(bits.iter())
+        .map(|&bits| f64::from_bits(bits))
+        .collect();
+    check_keys(&keys);
+    check_keys(&keys.iter().copied().map(Reverse).collect::<Vec<_>>());
+    check_keys(&[
+        f32::from_bits(0xffc0_1234),
+        0f32,
+        -0f32,
+        f32::NAN,
+        f32::NEG_INFINITY,
+        f32::INFINITY,
+    ]);
+}
+
+fn permutations(values: &mut [u16], at: usize, visit: &mut impl FnMut(&[u16])) {
+    if at == values.len() {
+        visit(values);
+        return;
+    }
+    for next in at..values.len() {
+        values.swap(at, next);
+        permutations(values, at + 1, visit);
+        values.swap(at, next);
+    }
+}
+
+#[test]
+fn exhaustively_materialize_every_small_bijection() {
+    let max = if cfg!(miri) { 5 } else { 7 };
+    for len in 0..=max {
+        let mut indices: Vec<u16> = (0..len as u16).collect();
+        permutations(&mut indices, 0, &mut |mapping| {
+            let mut records: Vec<_> = (0..len).map(|index| index.to_string()).collect();
+            let mut order = mapping.to_vec();
+            let mut seen = vec![0; len];
+            assert!(validate_permutation(&order, &mut seen));
+            let copies = permutation_moves(&order, &mut seen);
+            assert!(copies <= len + len / 2);
+            let mut temporary = MaybeUninit::<String>::uninit();
+            // SAFETY: the exhaustive generator yields a bijection; all records
+            // are initialized and temporary is a separate aligned writable slot.
+            unsafe { materialize(records.as_mut_ptr(), &mut order, temporary.as_mut_ptr()) };
+            for (destination, &source) in mapping.iter().enumerate() {
+                assert_eq!(records[destination], source.to_string());
+            }
+            assert!(order.iter().copied().eq(0..len as u16));
+        });
+    }
+    // Explicit two-cycles reach the 1.5N logical-copy bound; identity moves none.
+    assert_eq!(permutation_moves(&[1, 0, 3, 2], &mut [0; 4]), 6);
+    assert_eq!(permutation_moves(&[0, 1, 2, 3], &mut [0; 4]), 0);
+}
+
+#[test]
+fn malformed_maps_are_rejected_before_materialization() {
+    assert!(!validate_permutation(&[0, 0], &mut [0; 2]));
+    assert!(!validate_permutation(&[0, 2], &mut [0; 2]));
+    assert!(!validate_permutation(&[0], &mut [0; 2]));
+    assert!(validate_permutation(&[], &mut []));
+}
+
+#[repr(align(64))]
+struct Owned {
+    key: u64,
+    id: usize,
+    text: String,
+    bytes: Vec<u8>,
+    not_sync: Cell<usize>,
+    drops: Arc<Vec<AtomicUsize>>,
+}
+
+impl Drop for Owned {
+    fn drop(&mut self) {
+        self.drops[self.id].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+fn owned(len: usize, drops: &Arc<Vec<AtomicUsize>>) -> Vec<Owned> {
+    (0..len)
+        .map(|id| Owned {
+            key: mixed(id) % 23,
+            id,
+            text: id.to_string(),
+            bytes: vec![id as u8; 7],
+            not_sync: Cell::new(id),
+            drops: drops.clone(),
+        })
+        .collect()
+}
+
+#[test]
+fn key_panic_never_moves_this_tiles_records_and_workspace_reuses() {
+    let len = if cfg!(miri) { 65 } else { 129 };
+    for at in 1..=len {
+        let drops = Arc::new((0..len).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+        let mut records = owned(len, &drops);
+        let mut workspace = Workspace::new();
+        let mut calls = 0;
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            try_sort(
+                &mut records,
+                &mut ByKey(|row: &Owned| {
+                    calls += 1;
+                    assert!(calls != at, "injected key failure");
+                    row.key
+                }),
+                &mut workspace,
+            )
+        }));
+        assert!(result.is_err());
+        assert_eq!(calls, at);
+        for (id, row) in records.iter().enumerate() {
+            assert_eq!(row.id, id);
+            assert_eq!(row.text, id.to_string());
+            assert_eq!(row.bytes, vec![id as u8; 7]);
+            assert_eq!(row.not_sync.get(), id);
+        }
+        assert!(drops.iter().all(|count| count.load(Ordering::Relaxed) == 0));
+        assert!(try_sort(
+            &mut records,
+            &mut ByKey(|row: &Owned| row.key),
+            &mut workspace
+        ));
+        assert!(
+            records
+                .windows(2)
+                .all(|pair| (pair[0].key, pair[0].id) <= (pair[1].key, pair[1].id))
+        );
+        drop(records);
+        drop(workspace);
+        assert!(drops.iter().all(|count| count.load(Ordering::Relaxed) == 1));
+    }
+}
+
+#[test]
+fn inconsistent_callbacks_keep_owned_payloads_exactly_once() {
+    let len = 127;
+    let drops = Arc::new((0..len).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+    let mut records = owned(len, &drops);
+    let mut workspace = Workspace::new();
+    let mut calls = 0;
+    for _ in 0..3 {
+        assert!(try_sort(
+            &mut records,
+            &mut ByKey(|row: &Owned| {
+                calls += 1;
+                mixed(calls) ^ row.key
+            }),
+            &mut workspace
+        ));
+        records.sort_by_key(|row| row.id);
+        for (id, row) in records.iter().enumerate() {
+            assert_eq!(row.id, id);
+            assert_eq!(row.text, id.to_string());
+            assert_eq!(row.bytes, vec![id as u8; 7]);
+        }
+    }
+    drop(records);
+    drop(workspace);
+    assert!(drops.iter().all(|count| count.load(Ordering::Relaxed) == 1));
+}
+
+#[test]
+fn exclusive_references_survive_cycles_and_key_unwind() {
+    struct Borrowed<'a> {
+        key: u64,
+        id: usize,
+        value: &'a mut usize,
+        padding: [u8; 48],
+    }
+    let len = 127;
+    let mut values: Vec<_> = (0..len).collect();
+    {
+        let mut records: Vec<_> = values
+            .iter_mut()
+            .enumerate()
+            .map(|(id, value)| Borrowed {
+                key: mixed(id),
+                id,
+                value,
+                padding: [id as u8; 48],
+            })
+            .collect();
+        let mut workspace = Workspace::new();
+        let mut calls = 0;
+        assert!(
+            catch_unwind(AssertUnwindSafe(|| {
+                try_sort(
+                    &mut records,
+                    &mut ByKey(|row: &Borrowed<'_>| {
+                        calls += 1;
+                        assert!(calls != 31, "borrowed key failure");
+                        row.key
+                    }),
+                    &mut workspace,
+                )
+            }))
+            .is_err()
+        );
+        assert!(try_sort(
+            &mut records,
+            &mut ByKey(|row: &Borrowed<'_>| row.key),
+            &mut workspace
+        ));
+        for row in &mut records {
+            assert_eq!(*row.value, row.id);
+            assert_eq!(row.padding, [row.id as u8; 48]);
+            *row.value += len;
+        }
+    }
+    assert!(values.into_iter().eq(len..2 * len));
+}

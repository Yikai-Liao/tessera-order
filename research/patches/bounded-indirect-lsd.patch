+                // fully materialized a preceding tile on this very worker.
+                let phase = tile_metrics::snapshot();
+                if phase.capture_active
+                    && phase.indirect_tiles > 0
+                    && triggered
+                        .compare_exchange(false, true, Ordering::Relaxed, Ordering::Relaxed)

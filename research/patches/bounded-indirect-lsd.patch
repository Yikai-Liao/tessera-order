+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Bounded indirect leaves: snapshot encoded keys, sort indices, then move records.
+
+use alloc::vec::Vec;
+use core::mem::size_of;
+
+use crate::Workspace;
+use crate::key::{Extract, Unsigned};
+
+/// A fixed type-based research gate, independent of the key distribution.
+const MIN_RECORD_BYTES: usize = if cfg!(feature = "indirect-tiles-32") {
+    32
+} else {
+    64
+};
+/// This is a real contiguous record tile, never an index over the whole input.
+const MAX_RECORD_BYTES: usize = 64 * 1024;
+
+/// Key-width-independent storage allows one workspace to serve every key type.
+pub(crate) struct Buffers {
+    keys: Vec<u128>,
+    order: Vec<u16>,
+    spare: Vec<u16>,
+}
+
+impl Buffers {
+    pub(crate) fn new() -> Self {
+        Self {
+            keys: Vec::new(),
+            order: Vec::new(),
+            spare: Vec::new(),
+        }
+    }
+
+    pub(crate) fn retained_bytes(&self) -> usize {
+        self.keys.capacity() * size_of::<u128>()
+            + (self.order.capacity() + self.spare.capacity()) * size_of::<u16>()
+    }
+
+    fn reserve(&mut self, len: usize) {
+        self.keys.clear();
+        if self.keys.capacity() < len {
+            self.keys.reserve_exact(len);
+        }
+        for indices in [&mut self.order, &mut self.spare] {
+            if indices.capacity() < len {
+                indices.reserve_exact(len - indices.len());
+            }
+            indices.resize(len, 0);
+        }
+    }
+}
+
+/// Returns whether this bounded leaf was handled, leaving ineligible input alone.
+///
+/// The parent has already handled insertion-sized and zero-variation leaves.
+/// Encoded keys are captured once here. Earlier parent scans may have called the
+/// extractor; this is not a once-per-sort key guarantee. A changing extractor is
+/// ordered by this tile's snapshot, subject to any earlier parent partitioning.
+/// No ordering guarantee is made for inconsistent callbacks.
+///
+/// Recomputing variation from the snapshot rather than applying the parent's
+/// remaining-bit mask avoids discarding useful bits from these cached keys.
+/// For consistent keys, parent-fixed bits are equal throughout the tile, so
+/// including them cannot change ordering or the relative order of equal keys.
+/// A parent's narrowed encoder is sufficient under the same consistency rule.
+pub(crate) fn try_sort<T, E: Extract<T>>(
+    arr: &mut [T],
+    key: &mut E,
+    workspace: &mut Workspace<T>,
+) -> bool {
+    #[cfg(test)]
+    if crate::engine::tile_metrics::literal_forced() {
+        return false;
+    }
+    let len = arr.len();
+    let record_bytes = size_of::<T>();
+    if len < 2
+        || record_bytes < MIN_RECORD_BYTES
+        || len > u16::MAX as usize
+        || len
+            .checked_mul(record_bytes)
+            .is_none_or(|bytes| bytes > MAX_RECORD_BYTES)
+    {
+        return false;
+    }
+    workspace.indirect.reserve(len);
+    // Reuse retained record scratch as a single aligned slot. Allocating a
+    // Vec<MaybeUninit<T>> never constructs a potentially huge T on the stack.
+    // This does not free or pretend to replace older, larger tile capacity.
+    if workspace.tile.is_empty() {
+        workspace.tile.reserve_exact(1);
+        // SAFETY: capacity is at least one; any bits are valid MaybeUninit<T>.
+        // Its drop never reads or drops a T, including after unwinding.
+        unsafe { workspace.tile.set_len(1) };
+    }
+    let temporary = workspace.tile.as_mut_ptr().cast::<T>();
+    let buffers = &mut workspace.indirect;
+    // Every callback and every allocation finishes while arr still owns all T.
+    #[cfg(test)]
+    let capture = crate::engine::tile_metrics::begin_capture();
+    for record in arr.iter() {
+        buffers.keys.push(key.key(record).to_u128());
+    }
+    #[cfg(test)]
+    drop(capture);
+    let passes = sort_indices(&buffers.keys, &mut buffers.order, &mut buffers.spare);
+    // Reuse the spare index array as validation storage. This is a real check
+    // before any ownership transfer, including in optimized builds.
+    assert!(validate_permutation(&buffers.order, &mut buffers.spare));
+    #[cfg(test)]
+    let moves = permutation_moves(&buffers.order, &mut buffers.spare);
+    // SAFETY: validation proves order is an in-range bijection of arr's indices.
+    // The workspace allocation is aligned and disjoint from arr. No callback,
+    // allocation, bounds check, assertion, or destructor runs inside this cycle.
+    unsafe { materialize(arr.as_mut_ptr(), &mut buffers.order, temporary) };
+    #[cfg(test)]
+    crate::engine::tile_metrics::indirect(passes, moves);
+    #[cfg(not(test))]
+    let _ = passes;
+    true
+}
+
+/// Sorts original indices stably by the already normalized unsigned snapshots.
+fn sort_indices(keys: &[u128], order: &mut Vec<u16>, spare: &mut Vec<u16>) -> usize {
+    let mut varying = 0;
+    let first = keys.first().copied().unwrap_or(0);
+    for (index, &key) in keys.iter().enumerate() {
+        order[index] = index as u16;
+        varying |= key ^ first;
+    }
+    let mut passes = 0;
+    for shift in (0..u128::BITS).step_by(8) {
+        if (varying >> shift) & 255 == 0 {
+            continue;
+        }
+        let mut cursors = [0u16; 256];
+        for &index in order.iter() {
+            let bucket = ((keys[index as usize] >> shift) & 255) as usize;
+            cursors[bucket] += 1;
+        }
+        let mut offset = 0u16;
+        for cursor in &mut cursors {
+            let count = *cursor;
+            *cursor = offset;
+            offset += count;
+        }
+        for &index in order.iter() {
+            let bucket = ((keys[index as usize] >> shift) & 255) as usize;
+            spare[cursors[bucket] as usize] = index;
+            cursors[bucket] += 1;
+        }
+        core::mem::swap(order, spare);
+        passes += 1;
+    }
+    passes
+}
+
+fn validate_permutation(order: &[u16], seen: &mut [u16]) -> bool {
+    if order.len() != seen.len() || order.len() > u16::MAX as usize {
+        return false;
+    }
+    seen.fill(0);
+    for &source in order {
+        let Some(slot) = seen.get_mut(source as usize) else {
+            return false;
+        };
+        if *slot != 0 {
+            return false;
+        }
+        *slot = 1;
+    }
+    true
+}
+
+/// Materializes destination-to-source cycles without constructing a stack T.
+///
+/// # Safety
+///
+/// `records` addresses `order.len()` initialized writable T records. `order` is an
+/// in-range bijection, fits u16, and is disjoint from those records. `temporary`
+/// addresses one writable, correctly aligned T-sized slot disjoint from both.
+/// The scratch slot contains no live T and must not be read or dropped afterward.
+unsafe fn materialize<T>(records: *mut T, order: &mut [u16], temporary: *mut T) {
+    let len = order.len();
+    let map = order.as_mut_ptr();
+    let mut start = 0usize;
+    while start < len {
+        // SAFETY: start < len, and cycle validation establishes all other map
+        // indices below len. A bijection's cycle first returns to its own start.
+        // Each copy fills the unique logical hole and transfers ownership from
+        // its source. The final copy fills the hole from temporary, ending the
+        // temporary's ownership. Rewriting map entries to identity marks cycles
+        // visited without extra allocation. No T is duplicated as a live owner.
+        unsafe {
+            if *map.add(start) as usize != start {
+                core::ptr::copy_nonoverlapping(records.add(start), temporary, 1);
+                let mut hole = start;
+                loop {
+                    let source = *map.add(hole) as usize;
+                    *map.add(hole) = hole as u16;
+                    if source == start {
+                        core::ptr::copy_nonoverlapping(temporary, records.add(hole), 1);
+                        break;
+                    }
+                    core::ptr::copy_nonoverlapping(records.add(source), records.add(hole), 1);
+                    hole = source;
+                }
+            }
+        }
+        start = start.wrapping_add(1);
+    }
+}
+
+/// Counts logical record-copy operations, not machine instructions or bytes.
+#[cfg(test)]
+fn permutation_moves(order: &[u16], seen: &mut [u16]) -> usize {
+    seen.fill(0);
+    let mut moves = 0;
+    for start in 0..order.len() {
+        if seen[start] != 0 || order[start] as usize == start {
+            continue;
+        }
+        let mut position = start;
+        let mut length = 0;
+        loop {
+            seen[position] = 1;
+            length += 1;
+            position = order[position] as usize;
+            if position == start {
+                break;
+            }
+        }
+        // The saved first record makes one extra copy per nontrivial cycle.
+        moves += length + 1;
+    }
+    moves
+}

+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Full-width direct keys and owned parallel narrowing across both feature sets.
+
+#![cfg(all(feature = "rayon", not(miri)))]
+
+use std::cmp::Reverse;
+use tessera_sort::{par_stable_sort, par_stable_sort_by_key};
+
+fn random(id: usize) -> u64 {
+    let mut value = (id as u64).wrapping_add(0x9e37_79b9_7f4a_7c15);
+    value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    value ^ (value >> 31)
+}
+
+#[test]
+fn full_u128_and_each_half_use_direct_and_by_key_routes() {
+    for threads in [1, 2, 4] {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(threads)
+            .build()
+            .unwrap();
+        pool.install(|| {
+            let len = 65_537;
+            for shape in 0..3 {
+                let input: Vec<u128> = (0..len)
+                    .map(|id| {
+                        let low = u128::from(random(id / 3));
+                        let high = u128::from(random(id / 3 + len));
+                        match shape {
+                            0 => (high << 64) | low,
+                            1 => (u128::from(u64::MAX) << 64) | low,
+                            _ => (high << 64) | u128::from(u64::MAX),
+                        }
+                    })
+                    .collect();
+                let mut expected = input.clone();
+                expected.sort();
+                let mut actual = input.clone();
+                par_stable_sort(&mut actual);
+                assert_eq!(actual, expected, "threads={threads} shape={shape}");
+
+                let mut reversed: Vec<_> = input.iter().copied().map(Reverse).collect();
+                par_stable_sort(&mut reversed);
+                assert!(
+                    reversed
+                        .iter()
+                        .map(|value| value.0)
+                        .eq(expected.iter().rev().copied())
+                );
+
+                let mut records: Vec<_> = input
+                    .into_iter()
+                    .enumerate()
+                    .map(|(id, key)| (key, id))
+                    .collect();
+                let mut expected = records.clone();
+                expected.sort_by_key(|value| value.0);
+                par_stable_sort_by_key(&mut records, |value| value.0);
+                assert_eq!(records, expected, "threads={threads} shape={shape}");
+            }
+        });
+    }
+}

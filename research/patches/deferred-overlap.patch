+fn deferred_first_batch_clone_panic_precedes_root_return_and_children() {
+    struct FirstBatchClone(Arc<Hooks>);
+    impl Clone for FirstBatchClone {
+        fn clone(&self) -> Self {
+            if self.0.publication.load(SeqCst) > 0 {
+                assert_eq!(self.0.root_returned.load(SeqCst), 0);
+                assert_eq!(self.0.actual_sender_closed.load(SeqCst), 0);
+                assert_eq!(self.0.consumer_keys_ready.load(SeqCst), 0);
+                assert_eq!(self.0.consumers_started.load(SeqCst), 0);
+                panic!("first deferred child-key clone at original first batch");
+            }
+            Self(self.0.clone())
+        }
+    }
+    impl super::Extract<OwnedCell> for FirstBatchClone {
+        type Value = u64;
+        fn key(&mut self, row: &OwnedCell) -> u64 {
+            row.key
+        }
+    }
+    let len = 65_537;
+    let drops = Arc::new((0..len).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+    let mut rows: Vec<_> = (0..len)
+        .map(|id| OwnedCell {
+            key: value(id, false),
+            id,
+            text: id.to_string(),
+            visits: Cell::new(0),
+            drops: drops.clone(),
+        })
+        .collect();
+    let h = Arc::new(Hooks::default());
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap()
+            .install(|| {
+                test_witness::with_hooks(h.clone(), || {
+                    super::sort::<_, _, true>(&mut rows, FirstBatchClone(h.clone()));
+                });
+            });
+    }));
+    assert!(result.is_err());
+    assert!(h.publication.load(SeqCst) > 0);
+    assert_eq!(h.root_returned.load(SeqCst), 0);
+    assert_eq!(h.consumer_keys_ready.load(SeqCst), 0);
+    assert_eq!(h.consumer_calls.load(SeqCst), 0);
+    assert_eq!(h.consumers_started.load(SeqCst), 0);
+    let mut ids: Vec<_> = rows
+        .iter()
+        .map(|r| {
+            assert_eq!(r.text, r.id.to_string());
+            r.id
+        })
+        .collect();
+    ids.sort_unstable();
+    assert_eq!(ids, (0..len).collect::<Vec<_>>());
+    assert!(drops.iter().all(|n| n.load(SeqCst) == 0));
+    drop(rows);
+    assert!(drops.iter().all(|n| n.load(SeqCst) == 1));
+}

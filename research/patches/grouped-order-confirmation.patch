+/// Confirms a sampled direction, checking for inversions once per bounded group.
+/// Key extraction stays sequential and only keys, never records, are retained.
+fn confirm_direction<T, E: Extract<T>, const DESCENDING: bool>(
+    arr: &[T],
+    key: &mut E,
+    mut previous: E::Value,
+) -> bool {
+    let mut groups = arr.chunks_exact(16);
+    for group in &mut groups {
+        let mut ordered = true;
+        for record in group {
+            let value = key.key(record);
+            ordered &= if DESCENDING {
+                previous >= value
+            } else {
+                previous <= value
+            };
+            previous = value;
+        }
+        if !ordered {
+            return false;
+        }
+    }
+    for record in groups.remainder() {
+        let value = key.key(record);
+        if if DESCENDING {
+            previous < value
+        } else {
+            previous > value
+        } {
+            return false;
+        }
+        previous = value;
+    }
+    true
 }
 

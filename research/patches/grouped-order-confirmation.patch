+// SPDX-License-Identifier: BSD-2-Clause
+//! Order-confirmation stability, tail and panic coverage.
+use tessera_sort::stable_sort_by_key;
+
+#[test]
+fn confirmation_finds_inversions_between_sample_pairs_and_at_group_edges() {
+    let len = if cfg!(miri) { 128 } else { 65536 };
+    for offset in [0usize, 1, 14, 15, 16, 17, 30, 31] {
+        let mut rows: Vec<_> = (0..len).map(|i| (i as u64, i)).collect();
+        let index = if cfg!(miri) { 32 } else { 1024 } + offset;
+        rows.swap(index, index + 1);
+        let mut expected = rows.clone();
+        expected.sort_by_key(|row| row.0);
+        stable_sort_by_key(&mut rows, |row| row.0);
+        assert_eq!(rows, expected);
+    }
+}
+
+#[test]
+fn ordered_duplicate_prefix_and_tail_preserve_stability() {
+    for len in [2usize, 15, 16, 17, 31, 32, 33, 4097, 65536] {
+        if cfg!(miri) && len > 128 {
+            continue;
+        }
+        for descending in [false, true] {
+            let mut rows: Vec<_> = (0..len)
+                .map(|i| (if descending { (len - i) / 3 } else { i / 3 }, i))
+                .collect();
+            let mut expected = rows.clone();
+            expected.sort_by_key(|row| row.0);
+            stable_sort_by_key(&mut rows, |row| row.0);
+            assert_eq!(rows, expected);
+        }
+    }
+}
+
+#[cfg(feature = "std")]
+#[test]
+fn panic_in_order_confirmation_preserves_every_owned_record() {
+    use std::{
+        cell::Cell,
+        panic::{AssertUnwindSafe, catch_unwind},
+    };
+    let len = if cfg!(miri) { 128usize } else { 65536 };
+    let gate_calls = 2 * ((len - 1) / (len / 4096).max(1));
+    for after_gate in [1usize, 2, 15, 16, 17, 31, 32, 33] {
+        let mut rows: Vec<_> = (0..len).map(|i| (i as u64, i.to_string())).collect();
+        let original = rows.clone();
+        let calls = Cell::new(0);
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            stable_sort_by_key(&mut rows, |row| {
+                let call = calls.get() + 1;
+                calls.set(call);
+                assert_ne!(call, gate_calls + after_gate, "order extraction panic");
+                row.0
+            });
+        }));
+        assert!(result.is_err());
+        assert_eq!(rows, original);
+    }
+}

+    fn visitors<'a, T>(count: usize) -> Vec<GroupVisit<'a, T>> {
+        (0..count)
+            .map(|_| alloc::boxed::Box::new(|_: &mut [T]| {}) as GroupVisit<'a, T>)
+            .collect()
+    }

+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Bounded raw halos for independently compacted semantic bucket groups.
+//!
+//! This research path requires the canonical whole-block permutation. Each
+//! job materializes its entire group before running ordinary contiguous child
+//! sorts. It does not share the serial pipeline's waiting consumer queue.
+
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+#[derive(Clone, Copy, Debug)]
+struct Group {
+    first_bucket: usize,
+    end_bucket: usize,
+    next: usize,
+    end: usize,
+    partial: usize,
+    output: usize,
+    output_end: usize,
+    halo_start: usize,
+    halo_end: usize,
+    halo_offset: usize,
+}
+
+struct Job<'a, T> {
+    group: Group,
+    visitor: GroupVisit<'a, T>,
+    panic: Option<PanicPayload>,
+}
+
+struct Plan {
+    groups: Vec<Group>,
+    cells: usize,
+    cap: usize,
+}
+
+/// Returns the fixed record-cell cap, with no intermediate wrapping.
+fn snapshot_cap(n: usize, workers: usize) -> Option<usize> {
+    let floor = n.isqrt();
+    let root = floor.checked_add(usize::from(floor.checked_mul(floor)? != n))?;
+    Some(32usize.checked_mul(workers)?.checked_mul(root)?.min(n / 8))
+}
+
+fn layout_fits<T>(cells: usize) -> bool {
+    cells
+        .checked_mul(core::mem::size_of::<T>())
+        .is_some_and(|bytes| bytes <= isize::MAX as usize)
+}
+
+fn plan<T>(sorter: &Sorter<'_, '_, T>, ends: &[usize], workers: usize) -> Option<Plan> {
+    let n = sorter.blocks.input_len;
+    let b = sorter.blocks.block_size;
+    let head = sorter.bucket_count;
+    let full = n / b;
+    let buckets = ends.len();
+    let count = sorter.block_order.len();
+    let cap = snapshot_cap(n, workers)?;
+    let report = !cfg!(miri) && std::env::var_os("TESSERA_HALO_STATS").is_some();
+    if buckets == 0 || head % buckets != 0 || sorter.partial_blocks.len() != head {
+        return None;
+    }
+    let roots = head / buckets;
+    if roots == 0 || ends.last().copied() != Some(n) {
+        return None;
+    }
+    // Validate the sole geometry accepted by this movement kernel. No pointer
+    // or ownership changes occur until every checked operation has succeeded.
+    for (logical, &physical) in sorter.block_order.iter().enumerate() {
+        let expected = if logical >= count.checked_sub(head)? {
+            logical - (count - head)
+        } else {
+            logical.checked_add(head)?
+        };
+        if physical as usize != expected {
+            return None;
+        }
+    }
+    let mut records = 0usize;
+    let mut previous = head;
+    for (index, tail) in sorter.partial_blocks.iter().enumerate() {
+        if tail.order_index < previous || tail.len >= b {
+            return None;
+        }
+        records = records
+            .checked_add(tail.order_index.checked_sub(previous)?.checked_mul(b)?)?
+            .checked_add(tail.len)?;
+        previous = tail.order_index.checked_add(1)?;
+        if (index + 1) % roots == 0 && ends[index / roots] != records {
+            return None;
+        }
+    }
+    if records != n || previous != sorter.active_blocks_end {
+        return None;
+    }
+    for q in (2..=workers.min(buckets)).rev() {
+        let mut groups = Vec::new();
+        groups.try_reserve_exact(q).ok()?;
+        let mut cells = 0usize;
+        let mut balanced = true;
+        let max_records = n.div_ceil(q).checked_mul(2).unwrap_or(n);
+        for i in 0..q {
+            let first_bucket = i.checked_mul(buckets)? / q;
+            let end_bucket = (i + 1).checked_mul(buckets)? / q;
+            let first_tail = first_bucket.checked_mul(roots)?;
+            let last_tail = end_bucket.checked_mul(roots)?.checked_sub(1)?;
+            let begin = if first_bucket == 0 {
+                0
+            } else {
+                sorter.partial_blocks[first_tail - 1]
+                    .order_index
+                    .checked_add(1)?
+                    .checked_sub(head)?
+            };
+            let end = sorter.partial_blocks[last_tail]
+                .order_index
+                .checked_add(1)?
+                .checked_sub(head)?;
+            let output = if first_bucket == 0 {
+                0
+            } else {
+                ends[first_bucket - 1]
+            };
+            let output_end = ends[end_bucket - 1];
+            balanced &= output_end.checked_sub(output)? <= max_records;
+            // Clamp before multiplying: scratch virtual coordinates need not
+            // fit the address range of the input allocation.
+            let halo_end = end.min(full).checked_mul(b)?;
+            let halo_start = begin
+                .min(full)
+                .checked_mul(b)?
+                .max(output_end)
+                .min(halo_end);
+            let halo_offset = cells;
+            cells = cells.checked_add(halo_end.checked_sub(halo_start)?)?;
+            groups.push(Group {
+                first_bucket,
+                end_bucket,
+                next: begin,
+                end,
+                partial: first_tail,
+                output,
+                output_end,
+                halo_start,
+                halo_end,
+                halo_offset,
+            });
+        }
+        if report {
+            let largest = groups
+                .iter()
+                .map(|group| group.output_end - group.output)
+                .max()
+                .unwrap_or(0);
+            eprintln!(
+                "halo candidate n={n} B={b} roots={roots} R={buckets} Q={q} raw_cells={cells} cap={cap} largest_group={largest} max_group={max_records} balanced={balanced} fits={}",
+                cells <= cap && layout_fits::<T>(cells)
+            );
+        }
+        if balanced && cells <= cap && layout_fits::<T>(cells) {
+            return Some(Plan { groups, cells, cap });
+        }
+    }
+    None
+}
+
+struct Movement<'a, T> {
+    input: *mut T,
+    block_size: usize,
+    full: usize,
+    head: usize,
+    partials: &'a [PartialBlock],
+    scratch: &'a [*mut T],
+    segment_blocks: usize,
+    snapshots: *const MaybeUninit<T>,
+}
+
+// SAFETY: only raw addresses and immutable integer descriptors are shared.
+// Each job owns disjoint destinations and its sole authoritative sources.
+// Threatened sources are in disjoint staged halos before any job starts.
+unsafe impl<T: Send> Sync for Movement<'_, T> {}
+
+impl<T> Movement<'_, T> {
+    fn finish(&self, group: &mut Group, fault: Option<&Fault>) {
+        while group.next < group.end {
+            let k = group.next;
+            let mut partial = group.partial;
+            let len = if partial < self.partials.len()
+                // SAFETY: the preceding bound is checked, and the directory
+                // was fully validated before movement or snapshot staging.
+                && unsafe { self.partials.get_unchecked(partial).order_index } == self.head + k
+            {
+                // SAFETY: the preceding condition checked this descriptor.
+                let len = unsafe { self.partials.get_unchecked(partial).len };
+                partial += 1;
+                len
+            } else {
+                self.block_size
+            };
+            // SAFETY: validation proves every prefix is initialized, the sum
+            // fits this job's disjoint destination, and all additions fit.
+            // Copies of padding are never read as records. Within a job,
+            // forward memmove cannot destroy a later authoritative source.
+            unsafe {
+                let destination = self.input.add(group.output);
+                if k < self.full {
+                    let start = k * self.block_size;
+                    let original = len.min(group.halo_start.saturating_sub(start));
+                    if original != 0 {
+                        ptr::copy(self.input.add(start), destination, original);
+                    }
+                    if original < len {
+                        let offset = group.halo_offset + start + original - group.halo_start;
+                        ptr::copy_nonoverlapping(
+                            self.snapshots.add(offset).cast::<T>(),
+                            destination.add(original),
+                            len - original,
+                        );
+                    }
+                } else {
+                    let physical = k - self.full;
+                    let base = *self.scratch.get_unchecked(physical / self.segment_blocks);
+                    let source = base.add((physical % self.segment_blocks) * self.block_size);
+                    ptr::copy_nonoverlapping(source, destination, len);
+                }
+            }
+            // This entire copy/commit region cannot allocate, call user code,
+            // or unwind. Recovery resumes only at whole-prefix boundaries.
+            group.output += len;
+            group.partial = partial;
+            group.next += 1;
+            if let Some(fault) = fault {
+                fault.after_copy();
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+struct Fault {
+    completed: AtomicUsize,
+    fail_after: Option<usize>,
+    scheduled: AtomicUsize,
+    fail_schedule_after: Option<usize>,
+    fail_armed: bool,
+    #[cfg(test)]
+    scoped: bool,
+}
+
+impl Fault {
+    fn after_copy(&self) {
+        if let Some(fail_after) = self.fail_after {
+            let completed = self.completed.fetch_add(1, Ordering::Relaxed);
+            assert_ne!(completed, fail_after, "injected halo movement panic");
+        }
+    }
+}
+
+/// Owns the recovery obligation after the legacy directory becomes stale.
+/// Fields containing payloads or visitors drop only after this Drop body has
+/// completed every pending copy and marked the input materialized.
+struct Recovery<'a, 's, 'w, 'v, T> {
+    sorter: &'a mut Sorter<'s, 'w, T>,
+    jobs: Vec<Job<'v, T>>,
+    snapshots: Vec<MaybeUninit<T>>,
+    scratch: Vec<*mut T>,
+    segment_blocks: usize,
+}
+
+impl<T> Recovery<'_, '_, '_, '_, T> {
+    fn finish(&mut self) {
+        let movement = Movement {
+            input: self.sorter.blocks.input,
+            block_size: self.sorter.blocks.block_size,
+            full: self.sorter.blocks.input_len / self.sorter.blocks.block_size,
+            head: self.sorter.bucket_count,
+            partials: &self.sorter.partial_blocks,
+            scratch: &self.scratch,
+            segment_blocks: self.segment_blocks,
+            snapshots: self.snapshots.as_ptr(),
+        };
+        for job in &mut self.jobs {
+            movement.finish(&mut job.group, None);
+        }
+        self.sorter.input_materialized = true;
+    }
+}
+
+impl<T> Drop for Recovery<'_, '_, '_, '_, T> {
+    fn drop(&mut self) {
+        self.finish();
+    }
+}
+
+pub(super) fn squeeze<T: Send>(
+    sorter: &mut Sorter<'_, '_, T>,
+    ends: &[usize],
+    workers: usize,
+    parallel: bool,
+    visitors: Vec<GroupVisit<'_, T>>,
+) -> Option<PanicPayload> {
+    squeeze_with_fault(sorter, ends, workers, parallel, visitors, &Fault::default())
+}
+
+fn squeeze_with_fault<T: Send>(
+    sorter: &mut Sorter<'_, '_, T>,
+    ends: &[usize],
+    workers: usize,
+    parallel: bool,
+    mut visitors: Vec<GroupVisit<'_, T>>,
+    fault: &Fault,
+) -> Option<PanicPayload> {
+    assert!(!visitors.is_empty());
+    let fallback = |sorter: &mut Sorter<'_, '_, T>, visitors: &mut Vec<GroupVisit<'_, T>>| {
+        sorter.compact_with(ends, Some(&mut *visitors[0]))
+    };
+    let Some(plan) = plan(sorter, ends, workers.min(visitors.len())) else {
+        if !cfg!(miri) && std::env::var_os("TESSERA_HALO_STATS").is_some() {
+            eprintln!(
+                "halo fallback: no admissible Q>=2 plan; serial squeeze and one local child visitor"
+            );
+        }
+        return fallback(sorter, &mut visitors);
+    };
+    let mut snapshots = Vec::<MaybeUninit<T>>::new();
+    if snapshots.try_reserve_exact(plan.cells).is_err() || snapshots.capacity() > plan.cap {
+        drop(snapshots);
+        return fallback(sorter, &mut visitors);
+    }
+    snapshots.resize_with(plan.cells, MaybeUninit::uninit);
+    let mut scratch = Vec::new();
+    let segment_blocks = if sorter.blocks.scratch_segments.is_empty() {
+        scratch.push(sorter.blocks.scratch.as_mut_ptr().cast());
+        sorter.blocks.scratch_blocks
+    } else {
+        for segment in &mut sorter.blocks.scratch_segments {
+            scratch.push(segment.as_mut_ptr().cast());
+        }
+        sorter.blocks.scratch_blocks / scratch.len()
+    };
+    let mut jobs = Vec::with_capacity(plan.groups.len());
+    for (group, visitor) in plan.groups.into_iter().zip(visitors.drain(..)) {
+        jobs.push(Job {
+            group,
+            visitor,
+            panic: None,
+        });
+    }
+    // Any unused visitor (including a private generic extractor destructor)
+    // is dropped while the old directory is still authoritative.
+    drop(visitors);
+    if parallel {
+        let _ = rayon::current_num_threads();
+    }
+    let cancelled = AtomicBool::new(false);
+    let used_workers = AtomicUsize::new(0);
+    // Staging is nonpanicking and does not create typed references to holes.
+    // All halo snapshots complete before authority transfers to Recovery.
+    for job in &jobs {
+        let group = &job.group;
+        // SAFETY: these checked, pairwise-disjoint raw ranges lie within full
+        // input blocks, excluding the stale original tail. MaybeUninit copies
+        // preserve holes without reading their bytes as initialized values.
+        unsafe {
+            ptr::copy_nonoverlapping(
+                sorter
+                    .blocks
+                    .input
+                    .add(group.halo_start)
+                    .cast::<MaybeUninit<T>>(),
+                snapshots.as_mut_ptr().add(group.halo_offset),
+                group.halo_end - group.halo_start,
+            );
+        }
+    }
+    #[cfg(test)]
+    HALO_PLANS.with(|count| count.set(count.get() + 1));
+    let mut recovery = Recovery {
+        sorter,
+        jobs,
+        snapshots,
+        scratch,
+        segment_blocks,
+    };
+    assert!(
+        !fault.fail_armed,
+        "injected panic after halo ownership transfer"
+    );
+    let result = {
+        let movement = Movement {
+            input: recovery.sorter.blocks.input,
+            block_size: recovery.sorter.blocks.block_size,
+            full: recovery.sorter.blocks.input_len / recovery.sorter.blocks.block_size,
+            head: recovery.sorter.bucket_count,
+            partials: &recovery.sorter.partial_blocks,
+            scratch: &recovery.scratch,
+            segment_blocks,
+            snapshots: recovery.snapshots.as_ptr(),
+        };
+        let run = |job: &mut Job<'_, T>| {
+            let result = unwind::catch(|| {
+                if parallel {
+                    if let Some(index) = rayon::current_thread_index() {
+                        if index < usize::BITS as usize {
+                            used_workers.fetch_or(1 << index, Ordering::Relaxed);
+                        }
+                    }
+                }
+                movement.finish(&mut job.group, Some(fault));
+                debug_assert_eq!(job.group.output, job.group.output_end);
+                let mut begin = if job.group.first_bucket == 0 {
+                    0
+                } else {
+                    ends[job.group.first_bucket - 1]
+                };
+                for &end in &ends[job.group.first_bucket..job.group.end_bucket] {
+                    if cancelled.load(Ordering::Acquire) {
+                        break;
+                    }
+                    if end > begin {
+                        // SAFETY: the WHOLE group has completed, its sources
+                        // are retired, and other groups cannot read or write
+                        // these disjoint semantic bucket intervals.
+                        let child = unsafe {
+                            core::slice::from_raw_parts_mut(movement.input.add(begin), end - begin)
+                        };
+                        (job.visitor)(child);
+                    }
+                    begin = end;
+                }
+            });
+            if let Err(payload) = result {
+                cancelled.store(true, Ordering::Release);
+                job.panic = Some(payload);
+            }
+            if let Some(fail_after) = fault.fail_schedule_after {
+                let scheduled = fault.scheduled.fetch_add(1, Ordering::Relaxed);
+                if scheduled == fail_after {
+                    cancelled.store(true, Ordering::Release);
+                    panic!("injected halo scheduler panic");
+                }
+            }
+        };
+        // Per-job panics never reach Rayon's first-panic selection. In
+        // particular, independent simultaneous payloads cannot be dropped
+        // until all jobs and child calls have joined and recovery is complete.
+        unwind::catch(|| {
+            #[cfg(test)]
+            if fault.scoped {
+                std::thread::scope(|scope| {
+                    for job in &mut recovery.jobs {
+                        let run = &run;
+                        scope.spawn(move || run(job));
+                    }
+                });
+                return;
+            }
+            if parallel {
+                recovery.jobs.par_iter_mut().for_each(run);
+            } else {
+                recovery.jobs.iter_mut().for_each(run);
+            }
+        })
+    };
+    recovery.finish();
+    if !cfg!(miri) && std::env::var_os("TESSERA_HALO_STATS").is_some() {
+        let group_bytes = recovery
+            .jobs
+            .capacity()
+            .checked_mul(core::mem::size_of::<Job<'_, T>>())
+            .unwrap();
+        let source_bytes = recovery
+            .scratch
+            .capacity()
+            .checked_mul(core::mem::size_of::<*mut T>())
+            .unwrap();
+        let snapshot_bytes = recovery
+            .snapshots
+            .capacity()
+            .checked_mul(core::mem::size_of::<T>())
+            .unwrap();
+        eprintln!(
+            "halo groups={} cells={} capacity={} cap={} snapshot_bytes={} job_bytes={} source_bytes={} movement_workers={}",
+            recovery.jobs.len(),
+            recovery.snapshots.len(),
+            recovery.snapshots.capacity(),
+            plan.cap,
+            snapshot_bytes,
+            group_bytes,
+            source_bytes,
+            used_workers.load(Ordering::Relaxed).count_ones()
+        );
+    }
+    match result {
+        Err(payload) => Some(payload),
+        Ok(()) => recovery.jobs.iter_mut().find_map(|job| job.panic.take()),
+    }
+}

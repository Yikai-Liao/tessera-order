+    fn halo_nested_rayon_and_full_public_sort_make_progress() {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(4)
+            .build()
+            .unwrap();
+        let mut rows: Vec<_> = (0..1025usize).map(|id| (id % 4, id)).collect();
+        let nested_done = Arc::new(AtomicBool::new(false));
+        pool.install(|| {
+            let mut buffers = Buffers::new();
+            let mut sorter = Sorter::new(&mut rows, 4, 2, &mut buffers);
+            let (_, ends) = sorter.step_with_ends(|row| row.0, true);
+            compact::permute_blocks(&mut sorter, 4, true);
+            assert_eq!(plan(&sorter, &ends, 4).unwrap().groups.len(), 4);
+            let visits = (0..4)
+                .map(|_| {
+                    let nested_done = nested_done.clone();
+                    alloc::boxed::Box::new(move |child: &mut [(usize, usize)]| {
+                        rayon::join(
+                            || child.reverse(),
+                            || {
+                                if !nested_done.swap(true, Ordering::SeqCst) {
+                                    let mut nested: Vec<_> = (0..131_072u64)
+                                        .map(|i| {
+                                            (i.wrapping_mul(0x9e3779b97f4a7c15)).rotate_left(19)
+                                        })
+                                        .collect();
+                                    let mut expected = nested.clone();
+                                    expected.sort();
+                                    let before = HALO_PLANS.with(core::cell::Cell::get);
+                                    struct Reset;
+                                    impl Drop for Reset {
+                                        fn drop(&mut self) {
+                                            FORCE_HALO.with(|flag| flag.set(false));
+                                        }
+                                    }
+                                    FORCE_HALO.with(|flag| flag.set(true));
+                                    let _reset = Reset;
+                                    crate::par_stable_sort(&mut nested);
+                                    assert_eq!(nested, expected);
+                                    assert!(
+                                        HALO_PLANS.with(core::cell::Cell::get) > before,
+                                        "nested public call must accept an actual Q>1 halo plan"
+                                    );
+                                }
+                            },
+                        );
+                    }) as GroupVisit<'_, (usize, usize)>
+                })
+                .collect();
+            assert!(squeeze(&mut sorter, &ends, 4, true, visits).is_none());
+        });
+        assert!(nested_done.load(Ordering::SeqCst));
+    }

+    #[test]
+    fn halo_exclusive_references_after_child_panic() {
+        let n = if cfg!(miri) { 65 } else { 257 };
+        let mut backing: Vec<_> = (0..n).collect();
+        let mut rows: Vec<_> = backing.iter_mut().enumerate().collect();
+        let result = unwind::catch(|| {
+            let mut buffers = Buffers::new();
+            let mut sorter = Sorter::new(&mut rows, 4, 2, &mut buffers);
+            let (_, ends) = sorter.step_with_ends(|row| row.0 % 4, true);
+            compact::permute_blocks(&mut sorter, 2, !cfg!(miri));
+            assert!(plan(&sorter, &ends, 2).is_some());
+            let visits = (0..2)
+                .map(|_| {
+                    alloc::boxed::Box::new(|child: &mut [(usize, &mut usize)]| -> () {
+                        child.reverse();
+                        panic!("exclusive child panic");
+                    }) as GroupVisit<'_, (usize, &mut usize)>
+                })
+                .collect();
+            if let Some(payload) = squeeze(&mut sorter, &ends, 2, !cfg!(miri), visits) {
+                unwind::resume(payload);
+            }
+        });
+        assert!(result.is_err());
+        let mut ids = Vec::new();
+        for (id, record) in rows {
+            assert_eq!(*record, id);
+            *record += 1;
+            ids.push(id);
+        }
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+        assert_eq!(backing, (1..=n).collect::<Vec<_>>());
+    }
+
+    struct InspectOnDrop {
+        pointer: *const (usize, usize),
+        n: usize,
+        observed: Arc<AtomicUsize>,
+    }
+
+    // SAFETY: this test payload does not access the records until its Drop,
+    // which the recovery contract requires to occur after all jobs joined.
+    unsafe impl Send for InspectOnDrop {}
+
+    impl Drop for InspectOnDrop {
+        fn drop(&mut self) {
+            // SAFETY: the test retains the input allocation, and the contract
+            // under test guarantees full restoration and no remaining jobs.
+            let rows = unsafe { core::slice::from_raw_parts(self.pointer, self.n) };
+            let mut ids: Vec<_> = rows.iter().map(|row| row.1).collect();
+            ids.sort_unstable();
+            assert_eq!(ids, (0..self.n).collect::<Vec<_>>());
+            self.observed.fetch_add(1, Ordering::SeqCst);
+        }
+    }

+    #[test]
+    fn halo_owned_movement_scheduler_and_guard_unwind() {
+        let n = if cfg!(miri) { 65 } else { 257 };
+        for mode in 0..5 {
+            let drops = Arc::new((0..n).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+            let mut rows: Vec<_> = (0..n)
+                .map(|id| Owned {
+                    key: id * 37 % 4,
+                    id,
+                    text: id.to_string(),
+                    non_sync: Cell::new(id),
+                    drops: drops.clone(),
+                })
+                .collect();
+            let result = unwind::catch(|| {
+                let mut buffers = Buffers::new();
+                let mut sorter = Sorter::new(&mut rows, 4, 2, &mut buffers);
+                let (_, ends) = sorter.step_with_ends(|row| row.key, true);
+                compact::permute_blocks(&mut sorter, 2, !cfg!(miri));
+                assert!(plan(&sorter, &ends, 2).is_some());
+                let fault = Fault {
+                    fail_after: match mode {
+                        1 => Some(0),
+                        2 => Some(7),
+                        _ => None,
+                    },
+                    fail_schedule_after: if mode == 3 { Some(0) } else { None },
+                    fail_armed: mode == 4,
+                    ..Fault::default()
+                };
+                if let Some(payload) =
+                    squeeze_with_fault(&mut sorter, &ends, 2, !cfg!(miri), visitors(2), &fault)
+                {
+                    unwind::resume(payload);
+                }
+            });
+            assert_eq!(result.is_err(), mode != 0);
+            let mut expected: Vec<_> = (0..n).collect();
+            expected.sort_by_key(|id| id * 37 % 4);
+            assert_eq!(rows.iter().map(|row| row.id).collect::<Vec<_>>(), expected);
+            assert!(drops.iter().all(|count| count.load(Ordering::SeqCst) == 0));
+            drop(rows);
+            assert!(drops.iter().all(|count| count.load(Ordering::SeqCst) == 1));
+        }
+    }

+    struct Owned {
+        key: usize,
+        id: usize,
+        text: String,
+        non_sync: Cell<usize>,
+        drops: Arc<Vec<AtomicUsize>>,
+    }
+
+    impl Drop for Owned {
+        fn drop(&mut self) {
+            assert_eq!(self.text, self.id.to_string());
+            assert_eq!(self.non_sync.get(), self.id);
+            self.drops[self.id].fetch_add(1, Ordering::SeqCst);
+        }
+    }

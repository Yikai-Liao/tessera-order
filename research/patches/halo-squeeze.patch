+    #[test]
+    fn halo_scoped_threads_exclusive_retirement() {
+        let n = if cfg!(miri) { 65 } else { 257 };
+        let mut backing: Vec<_> = (0..n).map(Cell::new).collect();
+        let mut rows: Vec<_> = backing.iter_mut().enumerate().collect();
+        let visited = Arc::new(AtomicUsize::new(0));
+        {
+            let mut buffers = Buffers::new();
+            let mut sorter = Sorter::new(&mut rows, 4, 2, &mut buffers);
+            let (_, ends) = sorter.step_with_ends(|row| row.0 % 4, true);
+            compact::permute_blocks(&mut sorter, 3, false);
+            let q = plan(&sorter, &ends, 3).unwrap().groups.len();
+            assert!(q >= 2);
+            let visits = (0..3)
+                .map(|_| {
+                    let visited = visited.clone();
+                    alloc::boxed::Box::new(move |child: &mut [(usize, &mut Cell<usize>)]| {
+                        child.reverse();
+                        for (id, value) in child {
+                            assert_eq!(value.get(), *id);
+                            value.set(*id + 1);
+                        }
+                        visited.fetch_add(1, Ordering::SeqCst);
+                    }) as GroupVisit<'_, (usize, &mut Cell<usize>)>
+                })
+                .collect();
+            let fault = Fault {
+                scoped: true,
+                ..Fault::default()
+            };
+            assert!(squeeze_with_fault(&mut sorter, &ends, 3, false, visits, &fault).is_none());
+        }
+        assert_eq!(visited.load(Ordering::SeqCst), 4);
+        let mut ids = Vec::new();
+        for (id, value) in rows {
+            assert_eq!(value.get(), id + 1);
+            ids.push(id);
+        }
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+    }

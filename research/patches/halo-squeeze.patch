+    #[test]
+    fn halo_plan_accepts_uniform_and_falls_back_for_skew() {
+        for skew in [false, true] {
+            let mut rows: Vec<_> = (0..257usize)
+                .map(|id| if skew { 0 } else { id % 4 })
+                .collect();
+            let mut buffers = Buffers::new();
+            let mut sorter = Sorter::new(&mut rows, 4, 3, &mut buffers);
+            let (panic, ends) = sorter.step_with_ends(|row| *row, true);
+            assert!(panic.is_none());
+            compact::permute_blocks(&mut sorter, 4, !cfg!(miri));
+            let plan = plan(&sorter, &ends, 4);
+            if skew {
+                // Q=2 admits the bounded 2*ceil(n/Q) extreme. Higher Q is
+                // rejected; this deliberately does not require Q>2 balance.
+                assert!(plan.as_ref().is_none_or(|plan| plan.groups.len() == 2));
+            } else {
+                assert_eq!(plan.as_ref().unwrap().groups.len(), 4);
+            }
+            assert!(squeeze(&mut sorter, &ends, 4, !cfg!(miri), visitors(4)).is_none());
+        }
+        // The strict n/8 cap rejects even one cell at this geometry.
+        let mut rows = [1usize, 0];
+        let mut buffers = Buffers::new();
+        let mut sorter = Sorter::new(&mut rows, 2, 1, &mut buffers);
+        let (_, ends) = sorter.step_with_ends(|row| *row, true);
+        compact::permute_blocks(&mut sorter, 2, !cfg!(miri));
+        assert!(plan(&sorter, &ends, 2).is_none());
+        assert!(squeeze(&mut sorter, &ends, 2, !cfg!(miri), visitors(2)).is_none());
+    }

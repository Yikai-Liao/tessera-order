+        assert_eq!(snapshot_cap(10_000_000, 8), Some(809_728));
+        assert_eq!(snapshot_cap(63, 8), Some(7));
+        assert_eq!(snapshot_cap(64, 8), Some(8));
+        assert_eq!(snapshot_cap(usize::MAX, usize::MAX), None);
+        assert!(!layout_fits::<[u8; 16]>(usize::MAX));
+        assert!(layout_fits::<u8>(isize::MAX as usize));

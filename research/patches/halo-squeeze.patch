+pub(crate) fn enabled() -> bool {
+    #[cfg(test)]
+    if FORCE_HALO.with(core::cell::Cell::get) {
+        return true;
+    }
+    !cfg!(miri) && std::env::var_os("TESSERA_HALO_SQUEEZE").is_some()
+}

+    #[test]
+    fn halo_distinct_group_child_key_panics_after_movement() {
+        let n = if cfg!(miri) { 65 } else { 4097 };
+        let observed = Arc::new(AtomicUsize::new(0));
+        let moved_panics = Arc::new(AtomicUsize::new(0));
+        let barrier = Arc::new(std::sync::Barrier::new(2));
+        let mut rows: Vec<_> = (0..n).map(|id| (id % 2, id)).collect();
+        let mut buffers = Buffers::new();
+        let mut sorter = Sorter::new(&mut rows, 2, 2, &mut buffers);
+        let (_, ends) = sorter.step_with_ends(|row| row.0, true);
+        compact::permute_blocks(&mut sorter, 2, false);
+        assert_eq!(plan(&sorter, &ends, 2).unwrap().groups.len(), 2);
+        let visits = (0..2)
+            .map(|_| {
+                let mut payload = Some(InspectOnDrop {
+                    pointer: sorter.blocks.input,
+                    n,
+                    observed: observed.clone(),
+                });
+                let barrier = barrier.clone();
+                let moved_panics = moved_panics.clone();
+                alloc::boxed::Box::new(move |child: &mut [(usize, usize)]| {
+                    let base = child.as_ptr();
+                    barrier.wait();
+                    crate::stable_sort_by_key(child, |row| {
+                        // SAFETY: stable root partition leaves parity bucket IDs
+                        // in increasing order, at position id/2 within this child.
+                        let initial = unsafe { base.add(row.1 / 2) };
+                        if !core::ptr::eq(row, initial) {
+                            moved_panics.fetch_add(1, Ordering::SeqCst);
+                            std::panic::panic_any(payload.take().unwrap());
+                        }
+                        (row.1 as u64)
+                            .wrapping_mul(0x9e3779b97f4a7c15)
+                            .rotate_left(19)
+                    });
+                }) as GroupVisit<'_, (usize, usize)>
+            })
+            .collect();
+        // Exact production movement/run kernel, but native scoped threads
+        // also work under Miri without the Rayon dependency's assembly path.
+        let fault = Fault {
+            scoped: true,
+            ..Fault::default()
+        };
+        let result = squeeze_with_fault(&mut sorter, &ends, 2, false, visits, &fault);
+        assert!(result.is_some());
+        drop(result);
+        assert_eq!(moved_panics.load(Ordering::SeqCst), 2);
+        assert_eq!(observed.load(Ordering::SeqCst), 2);
+    }

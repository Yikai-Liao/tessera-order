+                                0 => id * 37 % 64,
+                                1 => id * 64 / n,
+                                2 => (n - 1 - id) * 64 / n,
+                                3 => 31,
+                                4 => (id % 4) * 16,
+                                _ => {
+                                    if id % 19 == 0 {
+                                        id % 64
+                                    } else {
+                                        0
+                                    }
+                                }
+                            };
+                            (key as u64, id)
+                        })
+                        .collect();

+// SPDX-License-Identifier: BSD-2-Clause
+
+//! The ordered specialization must perform the same copies and publication
+//! visits as the general interpreter, including zero-length and self copies.
+
+use super::*;
+use core::cell::Cell;
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[path = "ordered_reference.rs"]
+mod reference;
+
+// Physical IDs make independently allocated fixtures exactly comparable.
+#[derive(Debug, PartialEq, Eq)]
+pub(super) enum CompactEvent {
+    Evacuate {
+        source: usize,
+        destination: usize,
+        len: usize,
+    },
+    Copy {
+        source: usize,
+        start: usize,
+        len: usize,
+    },
+    VisitDue(usize),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Row {
+    bucket: usize,
+    id: usize,
+    text: String,
+    touched: Cell<bool>,
+}
+
+type FixtureResult = (Vec<Row>, Vec<CompactEvent>, Vec<Vec<usize>>);
+
+fn key(id: usize, len: usize, head: usize, distribution: usize) -> usize {
+    match distribution {
+        0 => 0,
+        1 => head - 1,
+        2 => id % 2 * (head - 1),
+        3 => (id * 37 + 11) % head,
+        _ => (len - id - 1) % head,
+    }
+}
+
+fn fixture<const MODE: usize>(
+    len: usize,
+    block_size: usize,
+    head: usize,
+    segments: usize,
+    distribution: usize,
+) -> FixtureResult {
+    let mut rows: Vec<_> = (0..len)
+        .map(|id| Row {
+            bucket: key(id, len, head, distribution),
+            id,
+            text: id.to_string(),
+            touched: Cell::new(false),
+        })
+        .collect();
+    let mut events = Vec::new();
+    let mut callbacks = Vec::new();
+    let mut buffers = Buffers::new();
+    {
+        let mut sorter = Sorter::new(&mut rows, head, block_size, &mut buffers);
+        let (panic, _) = sorter.step_with_ends(|row| row.bucket, true);
+        assert!(panic.is_none());
+        let mut ends = Vec::with_capacity(head);
+        let mut partial = 0;
+        let mut records = 0;
+        for logical in head..sorter.active_blocks_end {
+            records += sorter.next_block_len(logical, &mut partial);
+            if ends.len() < head && logical == sorter.partial_blocks[ends.len()].order_index {
+                ends.push(records);
+            }
+        }
+        assert_eq!(ends.len(), head);
+        assert_eq!(records, len);
+        // Split the same live MaybeUninit scratch allocation into equally sized
+        // physical segments, matching the global adopted storage's addressing.
+        // Moving MaybeUninit cells does not borrow or drop their contained T.
+        if segments > 1 {
+            assert_eq!(head % segments, 0);
+            let segment_len = sorter.blocks.scratch.len() / segments;
+            let mut scratch = core::mem::take(&mut sorter.blocks.scratch);
+            let mut pieces = Vec::with_capacity(segments);
+            for remaining in (1..segments).rev() {
+                pieces.push(scratch.split_off(remaining * segment_len));
+            }
+            pieces.push(scratch);
+            pieces.reverse();
+            sorter.blocks.scratch_segments = pieces;
+        }
+        compact::permute_blocks(&mut sorter, segments, false);
+        let count = sorter.block_order.len();
+        assert_eq!(sorter.blocks.scratch_blocks, 2 * head);
+        for (i, &physical) in sorter.block_order.iter().enumerate() {
+            assert_eq!(physical as usize, (i + head) % count);
+        }
+        let capacity = sorter.next_block_order.capacity();
+        let allocation = sorter.next_block_order.as_ptr();
+        let mut visit = |child: &mut [Row]| {
+            callbacks.push(child.iter().map(|row| row.id).collect());
+            for row in child {
+                row.touched.set(true);
+            }
+        };
+        let panic = match MODE {
+            // This calls the original production function without trace hooks.
+            0 => sorter.compact_with(&ends, Some(&mut visit)),
+            1 => sorter.compact_reference_with(&ends, Some(&mut visit), &mut events),
+            // SAFETY: permutation returned normally, and the rotation, scratch
+            // geometry, and normal pass boundary were checked above.
+            2 => unsafe { sorter.compact_ordered_with(&ends, Some(&mut visit), Some(&mut events)) },
+            _ => unreachable!(),
+        };
+        assert!(panic.is_none());
+        assert!(sorter.input_materialized);
+        assert_eq!(sorter.next_block_order.capacity(), capacity);
+        assert_eq!(sorter.next_block_order.as_ptr(), allocation);
+    }
+    let mut expected: Vec<_> = (0..len).collect();
+    expected.sort_by_key(|&id| key(id, len, head, distribution));
+    assert_eq!(rows.iter().map(|row| row.id).collect::<Vec<_>>(), expected);
+    assert!(rows.iter().all(|row| row.touched.get()));
+    (rows, events, callbacks)
+}
+
+#[test]
+fn ordered_exact_copy_and_visit_geometry_matrix() {
+    let lengths: Vec<_> = if cfg!(miri) {
+        vec![2, 7, 19]
+    } else {
+        (2..=65).chain([95, 96, 97, 127, 128, 129]).collect()
+    };
+    let blocks: &[usize] = if cfg!(miri) {
+        &[1, 5]
+    } else {
+        &[1, 2, 3, 7, 16, 32]
+    };
+    let geometries: &[(usize, usize)] = if cfg!(miri) {
+        &[(2, 1), (6, 3)]
+    } else {
+        &[(2, 1), (4, 1), (4, 2), (6, 3), (8, 4), (12, 3)]
+    };
+    let distributions = if cfg!(miri) { 3 } else { 5 };
+    let mut zero_copy = false;
+    let mut self_copy = false;
+    let mut partial_copy = false;
+    let mut crossed_segment = false;
+    for len in lengths {
+        for &block_size in blocks {
+            for &(head, segments) in geometries {
+                for distribution in 0..distributions {
+                    let production = fixture::<0>(len, block_size, head, segments, distribution);
+                    let generic = fixture::<1>(len, block_size, head, segments, distribution);
+                    let ordered = fixture::<2>(len, block_size, head, segments, distribution);
+                    assert_eq!(production.0, generic.0);
+                    assert_eq!(production.2, generic.2);
+                    assert!(production.1.is_empty());
+                    assert_eq!(
+                        generic, ordered,
+                        "n={len}, B={block_size}, H={head}, Q={segments}, distribution={distribution}"
+                    );
+                    for event in &ordered.1 {
+                        assert!(!matches!(event, CompactEvent::Evacuate { .. }));
+                        if let CompactEvent::Copy { source, start, len } = *event {
+                            zero_copy |= len == 0;
+                            partial_copy |= len > 0 && len < block_size;
+                            self_copy |=
+                                source >= 2 * head && start == (source - 2 * head) * block_size;
+                            crossed_segment |=
+                                segments > 1 && source < head && source >= 2 * head / segments;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    assert!(zero_copy && self_copy && partial_copy && crossed_segment);
+}
+
+#[test]
+fn ordered_max_radix_empty_bucket_boundaries() {
+    // The production maximum radix, with almost all buckets empty, exercises
+    // the maximum supported H without allocating a large input.
+    let head = if cfg!(miri) { 8 } else { 1 << MAX_RADIX_BITS };
+    for len in [2, 3, 7, 8, 9] {
+        let production = fixture::<0>(len, 3, head, 1, 1);
+        let reference = fixture::<1>(len, 3, head, 1, 1);
+        let ordered = fixture::<2>(len, 3, head, 1, 1);
+        assert_eq!(production.0, reference.0);
+        assert_eq!(production.2, reference.2);
+        assert_eq!(reference, ordered);
+    }
+}
+
+struct Owned {
+    id: usize,
+    text: String,
+    touched: Cell<usize>,
+    drops: Arc<Vec<AtomicUsize>>,
+}
+
+impl Drop for Owned {
+    fn drop(&mut self) {
+        assert_eq!(self.text, self.id.to_string());
+        self.drops[self.id].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+#[test]
+fn ordered_owned_cell_callback_panic_preserves_records() {
+    let n = if cfg!(miri) { 19 } else { 113 };
+    for fail in [None, Some(0), Some(1), Some(3)] {
+        let drops = Arc::new((0..n).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+        let mut rows: Vec<_> = (0..n)
+            .map(|id| Owned {
+                id,
+                text: id.to_string(),
+                touched: Cell::new(0),
+                drops: drops.clone(),
+            })
+            .collect();
+        let mut calls = 0;
+        let result = unwind::catch(|| {
+            partition_impl_with_visit(
+                &mut rows,
+                2,
+                0,
+                crate::key::ByKey(|row: &Owned| (row.id * 37) as u64),
+                &mut Buffers::new(),
+                Config {
+                    shards: 3,
+                    block_size: Some(3),
+                    parallel: !cfg!(miri),
+                },
+                Some(&mut |child| {
+                    let index = calls;
+                    calls += 1;
+                    for row in child {
+                        row.touched.set(row.touched.get() + 1);
+                    }
+                    assert_ne!(fail, Some(index), "ordered child panic");
+                }),
+            );
+        });
+        assert_eq!(result.is_err(), fail.is_some());
+        assert_eq!(calls, fail.map_or(4, |index| index + 1));
+        let mut ids: Vec<_> = rows.iter().map(|row| row.id).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+        assert!(drops.iter().all(|d| d.load(Ordering::Relaxed) == 0));
+        drop(rows);
+        assert!(drops.iter().all(|d| d.load(Ordering::Relaxed) == 1));
+    }
+}
+
+struct Retired<T> {
+    pointer: *mut T,
+    len: usize,
+}
+
+// SAFETY: each retired interval is initialized, disjoint from the producer's
+// remaining sources and destinations, and transferred to one scoped job.
+unsafe impl<T: Send> Send for Retired<T> {}
+
+impl<T> Retired<T> {
+    /// # Safety
+    /// The caller must own this retired interval exclusively and join every
+    /// use before its backing input allocation can be accessed or destroyed.
+    unsafe fn slice<'a>(self) -> &'a mut [T] {
+        // SAFETY: the scoped caller supplies the unique, live interval.
+        unsafe { core::slice::from_raw_parts_mut(self.pointer, self.len) }
+    }
+}
+
+#[test]
+fn ordered_scoped_borrowed_children_and_panics() {
+    let n = if cfg!(miri) { 23 } else { 293 };
+    for (producer_panic, child_panic) in
+        [(false, false), (true, false), (false, true), (true, true)]
+    {
+        let mut backing: Vec<_> = (0..n).collect();
+        let mut rows: Vec<_> = backing
+            .iter_mut()
+            .enumerate()
+            .map(|(id, value)| (((id * 73) % 64) as u64, id, value))
+            .collect();
+        let mut callbacks = 0;
+        let (started_send, started_recv) = std::sync::mpsc::channel();
+        let (release_send, release_recv) = std::sync::mpsc::channel();
+        let mut first_channels = Some((started_send, release_recv));
+        let result = unwind::catch(|| {
+            std::thread::scope(|scope| {
+                partition_impl_with_visit(
+                    &mut rows,
+                    2,
+                    4,
+                    crate::key::ByKey(|row: &(u64, usize, &mut usize)| row.0),
+                    &mut Buffers::new(),
+                    // Miri runs the identical scatter/permutation/squeeze
+                    // kernels with serial scheduling, not Crossbeam/Rayon.
+                    Config {
+                        shards: 3,
+                        block_size: Some(3),
+                        parallel: false,
+                    },
+                    Some(&mut |child| {
+                        callbacks += 1;
+                        if callbacks == 2 {
+                            release_send.send(()).unwrap();
+                            assert!(!producer_panic, "ordered scoped producer panic");
+                        }
+                        let retired = Retired {
+                            pointer: child.as_mut_ptr(),
+                            len: child.len(),
+                        };
+                        let channels = first_channels.take();
+                        let first = callbacks == 1;
+                        scope.spawn(move || {
+                            // SAFETY: compaction retired this disjoint bucket;
+                            // scope joins before the input rows are accessed.
+                            let child = unsafe { retired.slice() };
+                            if let Some((started, release)) = channels {
+                                // Keep this &mut slice live across producer
+                                // copies between the first two publications.
+                                started.send(()).unwrap();
+                                release.recv().unwrap();
+                            }
+                            child.sort_by_key(|row| row.0);
+                            for (_, _, value) in child {
+                                **value += 1;
+                            }
+                            assert!(!(first && child_panic), "ordered scoped child panic");
+                        });
+                        if first {
+                            started_recv.recv().unwrap();
+                        }
+                    }),
+                );
+            });
+        });
+        assert_eq!(result.is_err(), producer_panic || child_panic);
+        assert_eq!(callbacks, if producer_panic { 2 } else { 4 });
+        let mut ids: Vec<_> = rows.iter().map(|row| row.1).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+        for (key, id, value) in rows {
+            assert_eq!(*value, id + usize::from(!producer_panic || key >> 4 == 0));
+        }
+    }
+}

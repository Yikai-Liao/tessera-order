+#[test]
+fn owned_narrow_forwards_direct_count_and_by_key_declines() {
+    for shift in [0usize, 64] {
+        let base = 0x19b2_34c5_d6e7_f809_a1b2_c3d4_e5f6_0000u128 & !(255u128 << shift);
+        let input: Vec<_> = (0..129)
+            .map(|id| base | (((id as u128 * 181) & 255) << shift))
+            .collect();
+        let mut expected = input.clone();
+        expected.sort();
+        let mut actual = input.clone();
+        if shift == 0 {
+            assert!(Narrow::<_, 0>(Direct).try_count_window(&mut actual, 0, 8));
+        } else {
+            assert!(Narrow::<_, 64>(Direct).try_count_window(&mut actual, 0, 8));
+        }
+        assert_eq!(actual, expected);
+        let mut actual = input.clone();
+        let key = ByKey(|record: &u128| *record);
+        let filled = if shift == 0 {
+            Narrow::<_, 0>(key).try_count_window(&mut actual, 0, 8)
+        } else {
+            Narrow::<_, 64>(key).try_count_window(&mut actual, 0, 8)
+        };
+        assert!(!filled);
+        assert_eq!(actual, input);
+    }
+}

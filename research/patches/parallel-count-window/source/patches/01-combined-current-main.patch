+            expected.sort_by_key(|&id| random(id) % 8192);
+            par_stable_sort_by_key(&mut values, |x| {
+                x.edited.set(true);
+                random(x.id) % 8192
+            });
+            assert_eq!(values.iter().map(|x| x.id).collect::<Vec<_>>(), expected);
+            assert!(values.iter().all(|x| x.edited.get()));
+            verify_owned(values, &drops);
+        });

+#[test]
+fn partial_insertion_preserves_exclusive_records() {
+    for len in [63, 64, 65] {
+        let mut storage: Vec<_> = (0..len).collect();
+        let mut values: Vec<_> = storage
+            .iter_mut()
+            .enumerate()
+            .map(|(id, value)| (((len - id) / 3) as u64, id, value))
+            .collect();
+        let mut key = ByKey(|value: &(u64, usize, &mut usize)| value.0);
+        assert_eq!(key.insertion_sort(&mut values, 7), None);
+        let mut ids: Vec<_> = values.iter().map(|value| value.1).collect();
+        ids.sort_unstable();

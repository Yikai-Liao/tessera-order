+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Checks the extractor boundary shared by serial and parallel preparation.
+
+use alloc::vec::Vec;
+use core::cell::Cell;
+use core::cmp::Reverse;
+
+use crate::RadixKey;
+use crate::key::{ByKey, Direct, Extract};
+
+fn check_scans<K: RadixKey>(mut values: Vec<K>) {
+    values.sort_by_key(|value| value.encode());
+    assert_eq!(Direct.first_inversion(&values), None);
+    assert_eq!(ByKey(|value: &K| *value).first_inversion(&values), None);
+    let encoded: Vec<_> = values.iter().map(|value| value.encode()).collect();
+    if let Some(first) = encoded.first().copied() {
+        assert!(Direct.confirm_ascending(&values, first));
+        assert!(ByKey(|value: &K| *value).confirm_ascending(&values, first));
+        if let Some(larger) = encoded.iter().copied().find(|value| *value > first) {
+            assert!(!Direct.confirm_ascending(&values, larger));
+            assert!(!ByKey(|value: &K| *value).confirm_ascending(&values, larger));
+        }
+    }
+    for index in 0..values.len().saturating_sub(1) {
+        if encoded[index] == encoded[index + 1] {
+            continue;
+        }
+        for budget in [0, 1] {
+            let mut actual = values.clone();
+            actual.swap(index, index + 1);
+            assert_eq!(Direct.first_inversion(&actual), Some(index));
+            assert_eq!(
+                ByKey(|value: &K| *value).first_inversion(&actual),
+                Some(index)
+            );
+            assert!(!Direct.confirm_ascending(&actual, actual[0].encode()));
+            assert!(!ByKey(|value: &K| *value).confirm_ascending(&actual, actual[0].encode()));
+            // This invokes the selected insertion backend, rather than only
+            // the default scan reached through Direct::first_inversion.
+            assert_eq!(
+                Direct.insertion_sort(&mut actual, budget),
+                (budget == 1).then_some(1)
+            );
+            assert!(
+                actual
+                    .iter()
+                    .map(|value| value.encode())
+                    .eq(encoded.iter().copied())
+            );
+        }
+    }
+}
+
+#[test]
+fn direct_and_by_key_scan_boundaries() {
+    let lengths: &[usize] = if cfg!(miri) {
+        &[0, 1, 63, 64, 65]
+    } else {
+        &[0, 1, 2, 31, 63, 64, 65, 97, 129]
+    };
+    for &len in lengths {
+        macro_rules! check_integer {
+            ($($ty:ty),*) => {$(
+                let values: Vec<$ty> = (0..len)
+                    .map(|index| {
+                        let low = (index as u128).wrapping_mul(0x9e37_79b9_7f4a_7c15);
+                        (low.rotate_left(64) ^ low.wrapping_mul(37)) as $ty
+                    })
+                    .collect();
+                check_scans(values.clone());
+                check_scans(values.into_iter().map(Reverse).collect());
+            )*};
+        }
+        check_integer!(
+            u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, i128, isize
+        );
+
+        let float32 = [
+            0xffc0_0001,
+            0xff80_0001,
+            0xff80_0000,
+            0x8000_0001,
+            0x8000_0000,
+            0,
+            1,
+            0x7f80_0000,
+            0x7f80_0001,
+            0x7fc0_0001,
+        ];
+        let float64 = [
+            0xfff8_0000_0000_0001,
+            0xfff0_0000_0000_0001,
+            0xfff0_0000_0000_0000,
+            0x8000_0000_0000_0001,
+            0x8000_0000_0000_0000,
+            0,
+            1,
+            0x7ff0_0000_0000_0000,
+            0x7ff0_0000_0000_0001,
+            0x7ff8_0000_0000_0001,
+        ];
+        let values: Vec<_> = (0..len)
+            .map(|index| f32::from_bits(float32[index % float32.len()]))
+            .collect();
+        check_scans(values.clone());
+        check_scans(values.into_iter().map(Reverse).collect());
+        let values: Vec<_> = (0..len)
+            .map(|index| f64::from_bits(float64[index % float64.len()]))
+            .collect();
+        check_scans(values.clone());
+        check_scans(values.into_iter().map(Reverse).collect());
+    }
+}
+
+fn assert_stable_permutation(values: &[(u64, usize, Cell<bool>)], len: usize) {
+    let mut ids: Vec<_> = values.iter().map(|value| value.1).collect();
+    ids.sort_unstable();
+    assert_eq!(ids, (0..len).collect::<Vec<_>>());
+    for key in 0..=len as u64 / 3 {
+        let mut previous = None;
+        for value in values.iter().filter(|value| value.0 == key) {
+            assert!(previous.is_none_or(|id| id < value.1));
+            previous = Some(value.1);
+        }
+    }
+}
+
+#[test]
+fn partial_insertion_preserves_equal_key_order_and_cell_edits() {
+    for len in [63, 64, 65] {
+        for budget in [0, 1, 7, 63] {
+            let mut values: Vec<_> = (0..len)
+                .map(|id| (((len - id) / 3) as u64, id, Cell::new(false)))
+                .collect();
+            let mut key = ByKey(|value: &(u64, usize, Cell<bool>)| {
+                value.2.set(true);
+                value.0
+            });
+            assert_eq!(key.insertion_sort(&mut values, budget), None);
+            assert_stable_permutation(&values, len);
+            assert!(values.iter().any(|value| value.2.get()));
+            key.finish_insertion(&mut values);
+            assert_stable_permutation(&values, len);
+            assert!(values.windows(2).all(|pair| pair[0].0 <= pair[1].0));
+        }
+    }
+}

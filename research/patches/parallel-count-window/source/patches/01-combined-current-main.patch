+        .collect();
+    let base = values.as_ptr();
+    let moved = Cell::new(false);
+    let result = catch_unwind(AssertUnwindSafe(|| {
+        ByKey(|value: &Owned| {
+            value.edited.set(true);
+            if !core::ptr::eq(core::ptr::from_ref(value), base.wrapping_add(value.id)) {
+                moved.set(true);
+                std::panic::panic_any(0x51a7_u32);
+            }
+            value.key
+        })
+        .finish_insertion(&mut values);
+    }));
+    assert!(moved.get(), "panic must occur after a record changed slots");
+    assert_eq!(*result.unwrap_err().downcast::<u32>().unwrap(), 0x51a7);
+    assert!(drops.iter().all(|count| count.load(Ordering::Relaxed) == 0));
+    assert!(values.iter().any(|value| value.edited.get()));
+    values.sort_by_key(|value| value.id);
+    for (id, value) in values.iter().enumerate() {
+        assert_eq!(value.id, id);
+        assert_eq!(value.text, std::format!("record {id}"));
+    }
+    drop(values);
+    assert!(drops.iter().all(|count| count.load(Ordering::Relaxed) == 1));
+}

+        }
+        key.finish_insertion(&mut values);
+        assert!(values.windows(2).all(|pair| {
+            pair[0].0 < pair[1].0 || (pair[0].0 == pair[1].0 && pair[0].1 < pair[1].1)
+        }));
+        drop(values);
+        assert_eq!(storage, (len..2 * len).collect::<Vec<_>>());
+    }
+}

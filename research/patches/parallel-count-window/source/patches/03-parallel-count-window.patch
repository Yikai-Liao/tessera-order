+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Opt-in research control; normal calls retain parallel scheduling.
+
+use std::cell::Cell;
+thread_local! {
+    static SERIAL: Cell<bool> = const { Cell::new(false) };
+}
+
+pub(crate) fn serial() -> bool {
+    SERIAL.get()
+}
+
+/// Runs the same count-window algorithm with serial chunk scheduling.
+///
+/// Call this inside the desired Rayon pool's `install` closure, surrounding a
+/// normal `par_stable_sort` call. The pool size, table size, input/output chunk
+/// geometry, probes, budget and fallbacks remain identical. Only count and fill
+/// iterator execution changes. This thread-local scope does not propagate to
+/// explicitly spawned jobs; it restores the previous setting even on panic.
+/// Pool size one still takes the unchanged public serial fallback.
+///
+/// This opt-in private control is for attribution, not a replacement public
+/// sorting policy. Compare its result against both the parallel schedule and
+/// unchanged strong serial sorter; do not label all algorithm changes as
+/// threading gains.
+pub fn with_serial_schedule<R>(run: impl FnOnce() -> R) -> R {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            SERIAL.set(self.0);
+        }
+    }
+    let _reset = Reset(SERIAL.replace(true));
+    run()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn research_scope_restores_after_nesting_and_panic() {
+        assert!(!serial());
+        with_serial_schedule(|| {
+            assert!(serial());
+            with_serial_schedule(|| assert!(serial()));
+            assert!(serial());
+        });
+        assert!(!serial());
+        assert!(
+            std::panic::catch_unwind(|| with_serial_schedule(|| panic!("scope test"))).is_err()
+        );
+        assert!(!serial());
+    }
+
+    #[cfg(not(miri))]
+    #[test]
+    fn serial_control_retains_parallel_geometry_and_values() {
+        use crate::test_witness::{Hooks, with_hooks};
+        use std::sync::Arc;
+        for workers in [2, 3, 8] {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap()
+                .install(|| {
+                    let mut parallel: Vec<_> = (0..262_149)
+                        .map(|i| (i as u64).wrapping_mul(181) & 255)
+                        .collect();
+                    let mut serial = parallel.clone();
+                    let mut expected = parallel.clone();
+                    expected.sort();
+                    let parallel_hooks = Arc::new(Hooks::default());
+                    let serial_hooks = Arc::new(Hooks::default());
+                    with_hooks(parallel_hooks.clone(), || {
+                        crate::par_stable_sort(&mut parallel)
+                    });
+                    with_hooks(serial_hooks.clone(), || {
+                        with_serial_schedule(|| crate::par_stable_sort(&mut serial))
+                    });
+                    assert_eq!(serial, expected);
+                    assert_eq!(parallel, expected);
+                    let geometry = |hooks: &Hooks| {
+                        let mut rows: Vec<_> = hooks
+                            .count_work
+                            .lock()
+                            .unwrap()
+                            .iter()
+                            .map(|&(phase, _, len)| (phase, len))
+                            .collect();
+                        rows.sort();
+                        rows
+                    };
+                    assert_eq!(geometry(&serial_hooks), geometry(&parallel_hooks));
+                    assert_eq!(geometry(&serial_hooks).len(), 2 * workers);
+                    assert!(
+                        serial_hooks
+                            .count_work
+                            .lock()
+                            .unwrap()
+                            .iter()
+                            .all(|w| w.1 == rayon::current_thread_index().unwrap())
+                    );
+                });
+        }
+    }

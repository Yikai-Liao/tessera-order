+//! Squeeze the fixed rotation after successful parallel block permutation.
+
+#[cfg(test)]
+use super::ordered_tests::CompactEvent;
+use super::*;
+
+impl<T> Sorter<'_, '_, T> {
+    /// Materializes the rotation established by a completed block permutation.
+    ///
+    /// # Safety
+    ///
+    /// `compact::permute_blocks` must have returned normally on this sorter
+    /// immediately before this call. For C physical blocks and H free-prefix
+    /// blocks, `scratch_blocks = 2H` and `block_order[i] = (i + H) mod C`.
+    /// No scatter or squeeze may intervene. A partially completed squeeze is
+    /// not recoverable through the general directory, so this kernel must not
+    /// add fallible movement steps or user operations outside the callback
+    /// catch boundary. The first callback panic is retained while the remaining
+    /// copies finish, then `input_materialized` is set before returning it.
+    pub(super) unsafe fn compact_ordered_with<const COALESCE: bool>(
+        &mut self,
+        ends: &[usize],
+        mut visit: Option<Visit<'_, T>>,
+        #[cfg(test)] mut trace: Option<&mut Vec<CompactEvent>>,
+    ) -> Option<PanicPayload> {
+        // All fallible validation/allocation is before relocation. Failure here
+        // leaves the completed directory recoverable by the original Drop.
+        let b = self.blocks.block_size;
+        let h = self.bucket_count;
+        let c = self.block_order.len();
+        assert!(h > 0 && b > 0 && self.blocks.scratch_blocks == 2 * h);
+        assert!(c.checked_mul(2).is_some());
+        assert!(h <= self.active_blocks_end && self.active_blocks_end <= c);
+        assert_eq!(c, self.blocks.input_len / b + 2 * h);
+        assert!(self.active_blocks_end >= c - h);
+        assert!(
+            self.partial_blocks
+                .windows(2)
+                .all(|w| w[0].order_index < w[1].order_index)
+        );
+        assert!(
+            self.partial_blocks
+                .iter()
+                .all(|p| p.order_index >= h && p.order_index < self.active_blocks_end && p.len < b)
+        );
+        assert!(ends.windows(2).all(|w| w[0] <= w[1]));
+        assert!(ends.last().is_none_or(|&e| e <= self.blocks.input_len));
+        let segments = self.blocks.scratch_segments.len();
+        if segments == 0 {
+            assert_eq!(self.blocks.scratch.len(), (2 * h).checked_mul(b).unwrap());
+        } else {
+            assert_eq!((2 * h) % segments, 0);
+            let size = (2 * h / segments).checked_mul(b).unwrap();
+            assert!(self.blocks.scratch_segments.iter().all(|s| s.len() == size));
+        }
+        let mut total = 0usize;
+        let mut partial = 0;
+        for logical in h..self.active_blocks_end {
+            total = total
+                .checked_add(self.next_block_len(logical, &mut partial))
+                .unwrap();
+            assert!(total <= self.blocks.input_len);
+        }
+        assert_eq!(total, self.blocks.input_len);
+        #[cfg(test)]
+        if let Some(events) = trace.as_deref_mut() {
+            // Reserve before movement so recording cannot allocate during copies.
+            events.reserve(2 * (self.block_order.len() - self.bucket_count) + 1);
+        }
+        // The completed rotation fixes every source without interpreting maps.
+        // Keep next_block_order and its allocation owned by this sorter.
+        let input_ptr = self.blocks.input;
+        let mut remaining = ends;
+        let mut begin = 0;
+        let mut callback_panic = None;
+        let mut visit_due = |written: usize| {
+            let Some(callback) = visit.take() else {
+                return;
+            };
+            while let Some((&end, tail)) = remaining.split_first() {
+                if end > written {
+                    break;
+                }
+                if end > begin {
+                    // SAFETY: this bucket is fully materialized and no longer a
+                    // copy source; its input slice does not overlap scratch.
+                    let bucket = unsafe {
+                        core::slice::from_raw_parts_mut(input_ptr.add(begin), end - begin)
+                    };
+                    if let Err(payload) = unwind::catch(|| callback(bucket)) {
+                        callback_panic = Some(payload);
+                        return;
+                    }
+                }
+                begin = end;
+                remaining = tail;
+            }
+            visit = Some(callback);
+        };
+        let b = self.blocks.block_size;
+        let h = self.bucket_count;
+        let c = self.block_order.len();
+        let full = c - self.blocks.scratch_blocks;
+        let active = self.active_blocks_end;
+        let segment_blocks = if self.blocks.scratch_segments.is_empty() {
+            self.blocks.scratch_blocks
+        } else {
+            self.blocks.scratch_blocks / self.blocks.scratch_segments.len()
+        };
+        let mut start = 0;
+        let mut partial = 0;
+        let mut logical = h;
+        // This cursor follows semantic ends even when callbacks are absent or
+        // suppressed after a panic: both controls retain identical boundaries.
+        let mut end_cursor = 0;
+        while logical < active {
+            let length = self.next_block_len(logical, &mut partial);
+            let k = logical - h;
+            let source = if k < full {
+                self.blocks.scratch_blocks + k
+            } else {
+                k - full
+            };
+            let allocation_end = if k < full {
+                c
+            } else {
+                (source / segment_blocks + 1) * segment_blocks
+            };
+            let mut blocks = 1;
+            if COALESCE && length == b {
+                let next_partial = self
+                    .partial_blocks
+                    .get(partial)
+                    .map_or(active, |p| p.order_index);
+                let stop = active
+                    .min(next_partial)
+                    .min(logical + allocation_end - source);
+                // Stop on the original first prefix boundary reaching an end,
+                // including an end inside a full prefix and repeated zero ends.
+                while logical + blocks < stop
+                    && (end_cursor == ends.len() || start + blocks * b < ends[end_cursor])
+                {
+                    blocks += 1;
+                }
+            }
+            let records = if length == b { blocks * b } else { length };
+            let from = self.blocks.block_ptr(source);
+            #[cfg(test)]
+            if let Some(events) = trace.as_deref_mut() {
+                events.push(CompactEvent::Copy {
+                    source,
+                    start,
+                    len: records,
+                });
+            }
+            // SAFETY: preflight proves the output bounds and each live prefix.
+            // Full runs stop at partials, allocation ends and the first original
+            // publication boundary. Every cell is initialized within one source
+            // allocation. Packed input starts at or to the left of that source;
+            // memmove preserves overlap and cannot clobber the next source.
+            unsafe {
+                ptr::copy(from, input_ptr.add(start), records);
+            }
+            // Retain every original written cursor / visit_due invocation, not
+            // only the last one. No callback can occur before this run's last
+            // prefix, because the grouping condition stops at its first due end.
+            for _ in 0..blocks {
+                start += length;
+                #[cfg(test)]
+                if let Some(events) = trace.as_deref_mut() {
+                    events.push(CompactEvent::VisitDue(start));
+                }
+                visit_due(start);
+                while end_cursor < ends.len() && ends[end_cursor] <= start {
+                    end_cursor += 1;
+                }
+            }
+            logical += blocks;
+        }
+        #[cfg(test)]
+        if let Some(events) = trace {
+            events.push(CompactEvent::VisitDue(start));
+        }
+        visit_due(start);
+        self.input_materialized = true;
+        debug_assert!(visit.is_none() || remaining.is_empty());
+        assert_eq!(start, self.blocks.input_len);
+        self.input_materialized = true;
+        callback_panic
+    }
+}

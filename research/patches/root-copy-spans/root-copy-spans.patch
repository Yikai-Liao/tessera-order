+}
+#[cfg(any(feature = "ordered-one", feature = "ordered-coalesced"))]
+pub(super) fn check_trace<T>(trace: Option<&[super::ordered_tests::CompactEvent]>) {
+    let Some(trace) = trace else {
+        return;
+    };
+    let copies = trace
+        .iter()
+        .filter(|e| matches!(e, super::ordered_tests::CompactEvent::Copy { .. }))
+        .count();
+    let expected = match (
+        core::mem::size_of::<T>(),
+        cfg!(feature = "ordered-coalesced"),
+    ) {
+        (16, true) => 4099,
+        (8, true) => 4098,
+        (16, false) => 157285,
+        (8, false) => 79144,
+        _ => unreachable!(),
+    };
+    assert_eq!(copies, expected);
+    eprintln!(
+        "OBSERVED ordered ptr::copy source calls: record_size={} coalesced={} calls={}",
+        core::mem::size_of::<T>(),
+        cfg!(feature = "ordered-coalesced"),
+        copies
+    );
+}

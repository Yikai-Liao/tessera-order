+#[test]
+fn ordered_owned_cell_callback_panic_preserves_records() {
+    let n = if cfg!(miri) { 19 } else { 113 };
+    for fail in [None, Some(0), Some(1), Some(3)] {
+        let drops = Arc::new((0..n).map(|_| AtomicUsize::new(0)).collect::<Vec<_>>());
+        let mut rows: Vec<_> = (0..n)
+            .map(|id| Owned {
+                id,
+                text: id.to_string(),
+                touched: Cell::new(0),
+                drops: drops.clone(),
+            })
+            .collect();
+        let mut calls = 0;
+        let result = unwind::catch(|| {
+            partition_impl_with_visit(
+                &mut rows,
+                2,
+                0,
+                crate::key::ByKey(|row: &Owned| (row.id * 37) as u64),
+                &mut Buffers::new(),
+                Config {
+                    shards: 3,
+                    block_size: Some(3),
+                    parallel: !cfg!(miri),
+                },
+                Some(&mut |child| {
+                    let index = calls;
+                    calls += 1;
+                    for row in child {
+                        row.touched.set(row.touched.get() + 1);
+                    }
+                    assert_ne!(fail, Some(index), "ordered child panic");
+                }),
+            );
+        });
+        assert_eq!(result.is_err(), fail.is_some());
+        assert_eq!(calls, fail.map_or(4, |index| index + 1));
+        let mut ids: Vec<_> = rows.iter().map(|row| row.id).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+        assert!(drops.iter().all(|d| d.load(Ordering::Relaxed) == 0));
+        drop(rows);
+        assert!(drops.iter().all(|d| d.load(Ordering::Relaxed) == 1));
+    }
+}
+
+struct Retired<T> {
+    pointer: *mut T,
+    len: usize,
+}
+
+// SAFETY: each retired interval is initialized, disjoint from the producer's
+// remaining sources and destinations, and transferred to one scoped job.
+unsafe impl<T: Send> Send for Retired<T> {}
+
+impl<T> Retired<T> {
+    /// # Safety
+    /// The caller must own this retired interval exclusively and join every
+    /// use before its backing input allocation can be accessed or destroyed.
+    unsafe fn slice<'a>(self) -> &'a mut [T] {
+        // SAFETY: the scoped caller supplies the unique, live interval.
+        unsafe { core::slice::from_raw_parts_mut(self.pointer, self.len) }
+    }
+}
+
+#[test]
+fn ordered_scoped_borrowed_children_and_panics() {
+    let n = if cfg!(miri) { 23 } else { 293 };
+    for (producer_panic, child_panic) in
+        [(false, false), (true, false), (false, true), (true, true)]
+    {
+        let mut backing: Vec<_> = (0..n).collect();
+        let mut rows: Vec<_> = backing
+            .iter_mut()
+            .enumerate()
+            .map(|(id, value)| (((id * 73) % 64) as u64, id, value))
+            .collect();
+        let mut callbacks = 0;
+        let (started_send, started_recv) = std::sync::mpsc::channel();
+        let (release_send, release_recv) = std::sync::mpsc::channel();
+        let mut first_channels = Some((started_send, release_recv));
+        let result = unwind::catch(|| {
+            std::thread::scope(|scope| {
+                partition_impl_with_visit(
+                    &mut rows,
+                    2,
+                    4,
+                    crate::key::ByKey(|row: &(u64, usize, &mut usize)| row.0),
+                    &mut Buffers::new(),
+                    // Miri runs the identical scatter/permutation/squeeze
+                    // kernels with serial scheduling, not Crossbeam/Rayon.
+                    Config {
+                        shards: 3,
+                        block_size: Some(3),
+                        parallel: false,
+                    },
+                    Some(&mut |child| {
+                        callbacks += 1;
+                        if callbacks == 2 {
+                            release_send.send(()).unwrap();
+                            assert!(!producer_panic, "ordered scoped producer panic");
+                        }
+                        let retired = Retired {
+                            pointer: child.as_mut_ptr(),
+                            len: child.len(),
+                        };
+                        let channels = first_channels.take();
+                        let first = callbacks == 1;
+                        scope.spawn(move || {
+                            // SAFETY: compaction retired this disjoint bucket;
+                            // scope joins before the input rows are accessed.
+                            let child = unsafe { retired.slice() };
+                            if let Some((started, release)) = channels {
+                                // Keep this &mut slice live across producer
+                                // copies between the first two publications.
+                                started.send(()).unwrap();
+                                release.recv().unwrap();
+                            }
+                            child.sort_by_key(|row| row.0);
+                            for (_, _, value) in child {
+                                **value += 1;
+                            }
+                            assert!(!(first && child_panic), "ordered scoped child panic");
+                        });
+                        if first {
+                            started_recv.recv().unwrap();
+                        }
+                    }),
+                );
+            });
+        });
+        assert_eq!(result.is_err(), producer_panic || child_panic);
+        assert_eq!(callbacks, if producer_panic { 2 } else { 4 });
+        let mut ids: Vec<_> = rows.iter().map(|row| row.1).collect();
+        ids.sort_unstable();
+        assert_eq!(ids, (0..n).collect::<Vec<_>>());
+        for (key, id, value) in rows {
+            assert_eq!(*value, id + usize::from(!producer_panic || key >> 4 == 0));
+        }
+    }
+}

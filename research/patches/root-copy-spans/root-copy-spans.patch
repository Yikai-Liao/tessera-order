+    );
+    let c = sorter.block_order.len();
+    assert_eq!(c, 10_000_000 / b + 4096);
+    for (i, &p) in sorter.block_order.iter().enumerate() {
+        assert_eq!(p as usize, (i + 2048) % c);
+    }
+    let mut p = 0;
+    let mut written = 0;
+    let mut count = 0;
+    let mut i = 2048;
+    let mut end_index = 0;
+    while i < active {
+        let len = sorter.next_block_len(i, &mut p);
+        let source = (i + 2048) % c;
+        let boundary = if source >= 4096 {
+            c
+        } else {
+            (source / 512 + 1) * 512
+        };
+        let mut run = 1;
+        if len == b {
+            while i + run < active
+                && source + run < boundary
+                && written + run * b < ends[end_index]
+                && !sorter
+                    .partial_blocks
+                    .iter()
+                    .any(|p| p.order_index == i + run)
+            {
+                run += 1;
+            }
+        }
+        count += 1;
+        written += if len == b { run * b } else { len };
+        i += run;
+        while end_index + 1 < ends.len() && ends[end_index] <= written {
+            end_index += 1;
+        }
+    }
+    assert_eq!(count, calls);
+    eprintln!(
+        "native directory verified: size={} B={} active={} logical={} coalesced={} records={}",
+        core::mem::size_of::<T>(),
+        b,
+        active,
+        active - 2048,
+        count,
+        written
+    );
+}
+fn next(state: &mut u64) -> u64 {
+    *state = state.wrapping_add(0x9e3779b97f4a7c15);
+    let mut z = *state;
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
+    z ^ (z >> 31)
+}
+#[test]
+#[ignore = "explicit untimed 10M metadata gate"]
+fn native_seed1_directory_matches_prediction() {
+    CAPTURE.set(true);
+    let n = 10_000_000;
+    let mut state = 1;
+    let mut hash = 0xcbf29ce484222325u64;
+    let mut values: Vec<u64> = (0..n)
+        .map(|_| {
+            let k = next(&mut state);
+            for byte in k.to_le_bytes() {
+                hash = (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3);
+            }
+            k
+        })
+        .collect();
+    assert_eq!(hash, 0xc2333e730de5dd2c);
+    let mut rows: Vec<_> = values
+        .iter()
+        .enumerate()
+        .map(|(i, &k)| (k, i as u64))
+        .collect();
+    let config = Config {
+        shards: 8,
+        block_size: None,
+        parallel: true,
+    };
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(8)
+        .build()
+        .unwrap();
+    pool.install(|| {});
+    // Capture is thread-local, so enter it on the pool's calling worker.
+    pool.install(|| {
+        CAPTURE.set(true);
+        partition_impl(
+            &mut rows,
+            8,
+            56,
+            crate::key::ByKey(|r: &(u64, u64)| r.0),
+            &mut Buffers::new(),
+            config,
+        );
+        CAPTURE.set(false);
+    });
+    pool.install(|| {
+        CAPTURE.set(true);
+        partition_impl(
+            &mut values,
+            8,
+            56,
+            crate::key::ByKey(|r: &u64| *r),
+            &mut Buffers::new(),
+            config,
+        );
+        CAPTURE.set(false);
+    });
+    CAPTURE.set(false);
+}

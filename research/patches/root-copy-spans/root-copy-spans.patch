+#[test]
+fn ordered_focused_moving_kernel() {
+    for (n, b, h, segments, distribution) in [
+        (0, 1, 2, 1, 0),
+        (1, 1, 2, 1, 0),
+        (6, 7, 4, 2, 5),
+        (7, 7, 4, 2, 5),
+        (8, 7, 4, 2, 5),
+        (43, 3, 6, 3, 0),
+        (43, 3, 6, 3, 5),
+    ] {
+        let original = fixture::<0>(n, b, h, segments, distribution);
+        let one = fixture::<2>(n, b, h, segments, distribution);
+        let spans = fixture::<3>(n, b, h, segments, distribution);
+        assert_eq!(original.0, one.0);
+        assert_eq!(one.0, spans.0);
+        assert_eq!(original.2, one.2);
+        assert_eq!(one.2, spans.2);
+    }
+}

+#[test]
+fn ordered_exact_copy_and_visit_geometry_matrix() {
+    let lengths: Vec<_> = if cfg!(miri) {
+        vec![2, 7, 19]
+    } else {
+        (0..=65).chain([95, 96, 97, 127, 128, 129]).collect()
+    };
+    let blocks: &[usize] = if cfg!(miri) {
+        &[1, 5]
+    } else {
+        &[1, 2, 3, 7, 16, 32]
+    };
+    let geometries: &[(usize, usize)] = if cfg!(miri) {
+        &[(2, 1), (6, 3)]
+    } else {
+        &[(2, 1), (4, 1), (4, 2), (6, 3), (8, 4), (12, 3)]
+    };
+    let distributions = if cfg!(miri) { 3 } else { 6 };
+    let mut zero_copy = false;
+    let mut self_copy = false;
+    let mut partial_copy = false;
+    let mut crossed_segment = false;
+    for len in lengths {
+        for &block_size in blocks {
+            for &(head, segments) in geometries {
+                for distribution in 0..distributions {
+                    let production = fixture::<0>(len, block_size, head, segments, distribution);
+                    let generic = fixture::<1>(len, block_size, head, segments, distribution);
+                    let ordered = fixture::<2>(len, block_size, head, segments, distribution);
+                    let coalesced = fixture::<3>(len, block_size, head, segments, distribution);
+                    assert_eq!(ordered.0, coalesced.0);
+                    assert_eq!(ordered.2, coalesced.2);
+                    let visits = |events: &[CompactEvent]| {
+                        events
+                            .iter()
+                            .filter_map(|e| {
+                                if let CompactEvent::VisitDue(n) = e {
+                                    Some(*n)
+                                } else {
+                                    None
+                                }
+                            })
+                            .collect::<Vec<_>>()
+                    };
+                    assert_eq!(visits(&ordered.1), visits(&coalesced.1));
+                    // Flatten runs back into physical block prefixes, checking
+                    // exact logical record transport including zero copies.
+                    let flatten = |events: &[CompactEvent]| {
+                        let mut out = Vec::new();
+                        for e in events {
+                            if let CompactEvent::Copy { source, start, len } = *e {
+                                if len > block_size {
+                                    for j in 0..len / block_size {
+                                        out.push((source + j, start + j * block_size, block_size));
+                                    }
+                                } else {
+                                    out.push((source, start, len));
+                                }
+                            }
+                        }
+                        out
+                    };
+                    assert_eq!(flatten(&ordered.1), flatten(&coalesced.1));
+                    assert_eq!(production.0, generic.0);
+                    assert_eq!(production.2, generic.2);
+                    assert!(production.1.is_empty());
+                    assert_eq!(
+                        generic, ordered,
+                        "n={len}, B={block_size}, H={head}, Q={segments}, distribution={distribution}"
+                    );
+                    for event in &ordered.1 {
+                        assert!(!matches!(event, CompactEvent::Evacuate { .. }));
+                        if let CompactEvent::Copy { source, start, len } = *event {
+                            zero_copy |= len == 0;
+                            partial_copy |= len > 0 && len < block_size;
+                            self_copy |=
+                                source >= 2 * head && start == (source - 2 * head) * block_size;
+                            crossed_segment |=
+                                segments > 1 && source < head && source >= 2 * head / segments;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    assert!(zero_copy && self_copy && partial_copy && crossed_segment);
+}

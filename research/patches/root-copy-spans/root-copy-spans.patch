+#[test]
+fn ordered_arbitrary_ends_preserve_prefix_publication() {
+    for mode in 0..3 {
+        let mut rows: Vec<_> = (0..41).map(|i| (i % 2, i)).collect();
+        let mut buffers = Buffers::new();
+        let mut sorter = Sorter::new(&mut rows, 2, 7, &mut buffers);
+        assert!(sorter.step_with_ends(|r| r.0, true).0.is_none());
+        compact::permute_blocks(&mut sorter, 1, false);
+        let ends = [0, 0, 1, 6, 7, 7, 8, 19, 20, 21, 40, 41];
+        let mut events = Vec::new();
+        let mut seen = Vec::new();
+        let mut visit = |slice: &mut [(usize, usize)]| {
+            seen.push(slice.iter().map(|r| r.1).collect::<Vec<_>>());
+            for row in slice {
+                row.0 = 99;
+            }
+        };
+        // SAFETY: completed rotation, no intervening relocation.
+        let panic = unsafe {
+            if mode == 2 {
+                sorter.compact_reference_with(&ends, Some(&mut visit), &mut events)
+            } else if mode == 1 {
+                sorter.compact_ordered_with::<true>(&ends, Some(&mut visit), Some(&mut events))
+            } else {
+                sorter.compact_ordered_with::<false>(&ends, Some(&mut visit), Some(&mut events))
+            }
+        };
+        assert!(panic.is_none());
+        let mut expected: Vec<_> = (0..41).collect();
+        expected.sort_by_key(|i| i % 2);
+        let mut offset = 0;
+        let mut expected_callbacks = Vec::new();
+        for end in ends {
+            if end > offset {
+                expected_callbacks.push(expected[offset..end].to_vec());
+            }
+            offset = end;
+        }
+        assert_eq!(seen, expected_callbacks);
+        let visits: Vec<_> = events
+            .iter()
+            .filter_map(|e| {
+                if let CompactEvent::VisitDue(n) = e {
+                    Some(*n)
+                } else {
+                    None
+                }
+            })
+            .collect();
+        assert_eq!(visits, vec![7, 14, 21, 21, 28, 35, 41, 41]);
+    }
+}

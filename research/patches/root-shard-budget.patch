+    #[test]
+    fn root_budget_targets_floor_density_without_reducing_permutation_workers() {
+        for (len, bytes, buckets, minimum, expected) in [
+            (1_048_576, 4, 256, 0, 8),
+            (1_048_576, 4, 256, 4, 4),
+            (1_048_576, 4, 256, 8, 2),
+            (262_144, 40, 256, 4, 8),
+            (262_144, 40, 256, 8, 4),
+            (262_144, 128, 256, 4, 8),
+            (262_144, 128, 256, 8, 4),
+            (10_000_000, 8, 256, 8, 8),
+            (10_000_000, 16, 256, 8, 8),
+            (1_048_576, 4, 16, 8, 8),
+        ] {
+            let plan = root_plan(len, bytes, buckets, budget_config(8, minimum));
+            assert_eq!(plan.shards, expected);
+            assert_eq!(plan.permutation_workers, 8);
+        }
+    }
+
+    #[test]
+    fn root_budget_rounds_down_without_overflowing_products() {
+        // A second shard needs two complete per-shard floor budgets.
+        let threshold = 2 * 256 * 256 * 8;
+        for (len, expected) in [(threshold - 1, 1), (threshold, 2), (threshold + 1, 2)] {
+            assert_eq!(root_plan(len, 4, 256, budget_config(8, 8)).shards, expected);
+        }
+        for bytes in [1, 4, 40, 128, usize::MAX] {
+            for requested in [0, 1, 8, usize::MAX] {
+                for minimum in [0, 4, 8, usize::MAX] {
+                    for len in [2, 33, usize::MAX] {
+                        let plan = root_plan(len, bytes, 256, budget_config(requested, minimum));
+                        assert!((1..=requested.max(1).min(len)).contains(&plan.shards));
+                        assert!(plan.block_size >= BLOCK_RECORDS_FLOOR);
+                        assert_eq!(plan.permutation_workers, requested.max(1).min(len));
+                        if minimum == usize::MAX {
+                            assert_eq!(plan.shards, 1);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn root_budget_rebalances_block_size_after_capping_shards() {
+        let uncapped = root_plan(4_194_304, 1, 2, budget_config(8, 0));
+        let capped = root_plan(4_194_304, 1, 2, budget_config(8, 1024));
+        assert_eq!(uncapped.shards, 8);
+        assert_eq!(capped.shards, 2);
+        assert!(capped.block_size > uncapped.block_size);

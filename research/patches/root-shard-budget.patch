+    #[test]
+    fn root_budget_owned_callbacks_begin_after_all_key_calls() {
+        let len = if cfg!(miri) { 43 } else { 4097 };
+        for minimum in [0, 4, 8, usize::MAX] {
+            let published = AtomicUsize::new(0);
+            let mut rows: Vec<_> = (0..len)
+                .map(|id| {
+                    (
+                        ((id * 73 + 11) % 256) as u64,
+                        id,
+                        alloc::format!("row {id}"),
+                    )
+                })
+                .collect();
+            let mut expected = rows.clone();
+            expected.sort_by_key(|r| r.0 & 7);
+            let ends = partition_impl_with_visit(
+                &mut rows,
+                3,
+                0,
+                ByKey(|row: &(u64, usize, String)| {
+                    assert_eq!(published.load(Ordering::SeqCst), 0, "key after publication");
+                    row.0
+                }),
+                &mut Buffers::new(),
+                budget_config(8, minimum),
+                Some(&mut |child| {
+                    assert!(!child.is_empty());
+                    published.fetch_add(1, Ordering::SeqCst);
+                }),
+            );
+            assert_eq!(rows, expected);
+            assert_eq!(ends.last(), Some(&len));
+            assert!(published.load(Ordering::SeqCst) > 0);
+        }
+    }

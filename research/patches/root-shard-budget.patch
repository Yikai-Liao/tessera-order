+
+fn root_plan(len: usize, record_bytes: usize, bucket_count: usize, config: Config) -> RootPlan {
+    let requested = config.shards.max(1).min(len);
+    let record_floor = (BLOCK_BYTES_FLOOR / record_bytes)
+        .max(BLOCK_RECORDS_FLOOR)
+        .max(1);
+    let shards = if config.block_size.is_some() || config.min_blocks_per_bucket == 0 {
+        requested
+    } else {
+        // Successive divisions equal floor(len / (floor * buckets * minimum))
+        // without constructing an overflowing product. This is an average
+        // density budget, not a promise about a skewed bucket's occupancy.
+        let budget = len / record_floor / bucket_count / config.min_blocks_per_bucket;
+        requested.min(budget.max(1))
+    };
+    // Local and global directories coexist during adoption, hence twenty
+    // rather than ten metadata bytes per input block. Rebalance after capping
+    // root shards, retaining the ordinary record floors and explicit overrides.
+    let block_size = config.block_size.unwrap_or_else(|| {
+        let balanced = ((20.0 * len as f64)
+            / (2.0 * shards as f64 * bucket_count as f64 * record_bytes as f64))
+            .sqrt()
+            .ceil() as usize;
+        balanced.max(record_floor)
+    });
+    let shards = shards.min((len / block_size).max(1));
+    RootPlan {
+        shards,
+        block_size,
+        // The root budget does not reduce block-permutation concurrency. An
+        // explicit block-size test keeps its original complete configuration.
+        permutation_workers: if config.block_size.is_some() {
+            shards
+        } else {
+            requested
+        },
+    }
 }
 

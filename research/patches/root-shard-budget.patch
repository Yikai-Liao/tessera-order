+        let len = if cfg!(miri) { 43 } else { 4097 };
+        let mut backing: Vec<_> = (0..len).collect();
+        let mut rows: Vec<_> = backing.iter_mut().enumerate().collect();
+        let calls = AtomicUsize::new(0);
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            partition_impl_with_visit(
+                &mut rows,
+                3,
+                0,
+                ByKey(|row: &(usize, &mut usize)| row.0.wrapping_mul(73) as u64),
+                &mut Buffers::new(),
+                budget_config(8, usize::MAX),
+                Some(&mut |_| {
+                    if calls.fetch_add(1, Ordering::SeqCst) == 1 {
+                        panic!("serial-root second materialized bucket");
+                    }
+                }),
+            );
+        }));
+        assert!(result.is_err());
+        assert_eq!(calls.load(Ordering::SeqCst), 2);
+        let mut ids = Vec::new();
+        for (id, value) in rows {
+            assert_eq!(id, *value);
+            *value += 1;
+            ids.push(id);
+        }
+        ids.sort_unstable();
+        assert_eq!(ids, (0..len).collect::<Vec<_>>());
+        assert_eq!(backing, (1..=len).collect::<Vec<_>>());
+    }
 

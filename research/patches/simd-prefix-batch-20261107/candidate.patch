+// SPDX-License-Identifier: BSD-2-Clause
+//! Boundary coverage for the four-group prefix loop.
+
+use super::*;
+
+fn levels() -> Vec<Level> {
+    #[cfg(miri)]
+    {
+        vec![Level::fallback()]
+    }
+    #[cfg(not(miri))]
+    {
+        let detected = Level::new();
+        let mut levels = vec![Level::baseline()];
+        #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
+        {
+            if let Some(simd) = detected.as_sse4_2() {
+                levels.push(simd.level());
+            }
+            if let Some(simd) = detected.as_avx2() {
+                levels.push(simd.level());
+            }
+            if let Some(simd) = detected.as_avx512() {
+                levels.push(simd.level());
+            }
+        }
+        #[cfg(not(any(target_arch = "x86", target_arch = "x86_64")))]
+        levels.push(detected);
+        levels
+    }
+}
+
+fn check(counts: &[u16], offset: usize, level: Level) {
+    let mut total = 0u32;
+    let expected: Vec<_> = counts
+        .iter()
+        .map(|&count| {
+            let start = total;
+            total += u32::from(count);
+            assert!(total <= u32::from(u16::MAX));
+            start as u16
+        })
+        .collect();
+    let mut actual = vec![0xa55a; offset + counts.len() + 3];
+    actual[offset..offset + counts.len()].copy_from_slice(counts);
+    dispatch!(level, simd => prefix_sum_with(simd, &mut actual[offset..offset + counts.len()]));
+    assert_eq!(
+        &actual[offset..offset + counts.len()],
+        expected,
+        "{level:?}, length={}, offset={offset}",
+        counts.len()
+    );
+    assert!(actual[..offset].iter().all(|&value| value == 0xa55a));
+    assert!(
+        actual[offset + counts.len()..]
+            .iter()
+            .all(|&value| value == 0xa55a)
+    );
+}
+
+#[test]
+fn prefix_batch_all_lengths() {
+    // Every supported count-table length, including all remainder combinations.
+    let max = if cfg!(miri) { 65 } else { 16_384 };
+    for level in levels() {
+        for length in 0..=max {
+            let counts: Vec<_> = (0..length)
+                .map(|index| ((index * 37 + length * 11) % 4) as u16)
+                .collect();
+            check(&counts, length % 4, level);
+        }
+    }
+}
+
+#[test]
+fn prefix_batch_boundaries() {
+    let mut lengths = vec![
+        0, 1, 2, 7, 8, 9, 15, 16, 17, 23, 24, 25, 30, 31, 32, 33, 34, 63, 64, 65, 95, 96, 97, 255,
+        256, 257,
+    ];
+    if !cfg!(miri) {
+        for power in 9..=14 {
+            lengths.extend([(1 << power) - 1, 1 << power]);
+            if power < 14 {
+                lengths.push((1 << power) + 1);
+            }
+        }
+    }
+    for level in levels() {
+        for &length in &lengths {
+            for offset in 0..4 {
+                check(&vec![0; length], offset, level);
+                check(
+                    &(0..length)
+                        .map(|index| if index % 2 == 0 { 3 } else { 0 })
+                        .collect::<Vec<_>>(),
+                    offset,
+                    level,
+                );
+                if length == 0 {
+                    continue;
+                }
+                // Dense counts sum to exactly 65535, including a nonzero final lane.
+                let counts: Vec<_> = (0..length)
+                    .map(|index| (65_535 / length + usize::from(index < 65_535 % length)) as u16)
+                    .collect();
+                check(&counts, offset, level);
+                let positions: Vec<_> = if length <= 65 {
+                    (0..length).collect()
+                } else {
+                    vec![0, 7, 8, 15, 16, 23, 24, 30, 31, 32, length / 2, length - 1]
+                };
+                for position in positions {
+                    let mut counts = vec![0; length];
+                    counts[position] = u16::MAX;
+                    check(&counts, offset, level);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn prefix_batch_dispatch_report() {
+    let detected = Level::new();
+    let selected = dispatch!(detected, simd => simd.level());
+    eprintln!(
+        "detected={detected:?}, selected={selected:?}, tested={:?}",
+        levels()
+    );
+}

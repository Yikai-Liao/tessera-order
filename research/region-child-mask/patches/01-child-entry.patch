+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Sealed controls for u64, Row16 and Row128; not a generic sorting API.
+//!
+//! The caller must supply a candidate containing every varying input bit. The
+//! aligned root supplies u64::MAX with its fixed high root digit removed. These
+//! functions do not establish Owned-record, inconsistent-key or panic guarantees.
+
+use crate::{
+    Workspace, engine,
+    key::{ByKey, Direct},
+};
+
+/// Child-entry controls sharing the same current leaf implementation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChildMode {
+    /// Calls the original, unmodified Workspace public entry.
+    Public,
+    /// Calls the duplicate preparation with the full u64 saturation mask.
+    Full,
+    /// Calls the same duplicate preparation with the root-excluded mask.
+    Masked,
+}
+
+/// Fixed-key record with an original-position payload for stability checks.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(C)]
+pub struct Row16 {
+    /// Intrinsic unsigned key.
+    pub key: u64,
+    /// Original position.
+    pub id: u64,
+}
+
+/// Wide Copy record with a stable ID and payload checked by full equality.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(C)]
+pub struct Row128 {
+    /// Intrinsic unsigned key.
+    pub key: u64,
+    /// Original position.
+    pub id: u64,
+    /// Payload that must follow its record unchanged.
+    pub payload: [u64; 14],
+}
+
+/// Sorts a valid materialized u64 root child with Direct/CACHED=false.
+pub fn sort_u64(
+    workspace: &mut Workspace<u64>,
+    values: &mut [u64],
+    mode: ChildMode,
+    candidate: u128,
+) {
+    #[cfg(feature = "child-scan-diagnostics")]
+    let _report = diagnostics::begin_child(values, |key| *key, mode, candidate);
+    match mode {
+        ChildMode::Public => workspace.stable_sort(values),
+        ChildMode::Full | ChildMode::Masked => engine::sort_root_child::<_, _, false>(
+            values,
+            &mut Direct,
+            Some(workspace),
+            crate::thresholds::TILE_BYTES,
+            (mode == ChildMode::Masked).then_some(candidate),
+        ),
+    }
+}
+
+/// Sorts a valid materialized Row16 root child with ByKey/CACHED=true.
+pub fn sort_row16(
+    workspace: &mut Workspace<Row16>,
+    values: &mut [Row16],
+    mode: ChildMode,
+    candidate: u128,
+) {
+    #[cfg(feature = "child-scan-diagnostics")]
+    let _report = diagnostics::begin_child(values, |record| record.key, mode, candidate);
+    match mode {
+        ChildMode::Public => workspace.stable_sort_by_key(values, |record| record.key),
+        ChildMode::Full | ChildMode::Masked => engine::sort_root_child::<_, _, true>(
+            values,
+            &mut ByKey(|record: &Row16| record.key),
+            Some(workspace),
+            crate::thresholds::TILE_BYTES,
+            (mode == ChildMode::Masked).then_some(candidate),
+        ),
+    }
+}
+
+/// Sorts a valid materialized Row128 root child with ByKey/CACHED=true.
+pub fn sort_row128(
+    workspace: &mut Workspace<Row128>,
+    values: &mut [Row128],
+    mode: ChildMode,
+    candidate: u128,
+) {
+    #[cfg(feature = "child-scan-diagnostics")]
+    let _report = diagnostics::begin_child(values, |record| record.key, mode, candidate);
+    match mode {
+        ChildMode::Public => workspace.stable_sort_by_key(values, |record| record.key),
+        ChildMode::Full | ChildMode::Masked => engine::sort_root_child::<_, _, true>(
+            values,
+            &mut ByKey(|record: &Row128| record.key),
+            Some(workspace),
+            crate::thresholds::TILE_BYTES,
+            (mode == ChildMode::Masked).then_some(candidate),
+        ),
+    }
+}
+
+/// Non-timing witnesses; entirely absent without child-scan-diagnostics.
+#[cfg(feature = "child-scan-diagnostics")]
+pub mod diagnostics;

+// SPDX-License-Identifier: BSD-2-Clause
+
+/// Public preparation copied without changing its order, probes, or node policy.
+pub(crate) fn sort_root_child<T, E: Extract<T>, const CACHED: bool>(
+    records: &mut [T],
+    extractor: &mut E,
+    mut workspace: Option<&mut Workspace<T>>,
+    tile_bytes: usize,
+    candidate: Option<u128>,
+) {
+    let record_bytes = core::mem::size_of::<T>();
+    if records.len() < 2 || record_bytes == 0 {
+        return;
+    }
+    let tile_bytes = tile_bytes
+        .max(record_bytes)
+        .min(MAX_TILE_RECORDS.saturating_mul(record_bytes));
+    let sampled = probe_order(records, extractor);
+    match sampled {
+        Order::Ascending => return,
+        Order::Descending => {
+            reverse_stably(records, extractor);
+            return;
+        }
+        Order::Unsorted => {
+            let probe_len = (tile_bytes / record_bytes).max(2).min(records.len());
+            let probe = workspace
+                .as_deref_mut()
+                .map(|workspace| &mut workspace.probe);
+            if insertion_probe(records, extractor, probe_len, probe) {
+                return;
+            }
+        }
+        Order::Flat => {}
+    }
+    let varying = child_mask_scan(records, candidate, extractor);
+    if varying == 0 {
+        return;
+    }
+    if sampled == Order::Flat {
+        match confirm_order(records, extractor) {
+            Order::Ascending => return,
+            Order::Descending => {
+                reverse_stably(records, extractor);
+                return;
+            }
+            _ => {}
+        }
+    }
+    // Free calls allocate scratch only now, so ordered and constant inputs
+    // never allocate.
+    let mut owned_workspace;
+    let workspace = match workspace {
+        Some(workspace) => workspace,
+        None => {
+            owned_workspace = Workspace::new();
+            &mut owned_workspace
+        }
+    };
+    if E::Value::BITS > 64 {
+        if varying >> 64 == 0 {
+            Sorter::<T, _, CACHED> {
+                workspace,
+                extractor: &mut KeyHalf::<_, 0>(extractor),
+                tile_bytes,
+            }
+            .sort_node(records, varying);
+            return;
+        }
+        if varying & ((1u128 << 64) - 1) == 0 {
+            Sorter::<T, _, CACHED> {
+                workspace,
+                extractor: &mut KeyHalf::<_, 64>(extractor),
+                tile_bytes,
+            }
+            .sort_node(records, varying >> 64);
+            return;
+        }
+    }
+    Sorter::<T, E, CACHED> {
+        workspace,
+        extractor,
+        tile_bytes,
+    }
+    .sort_node(records, varying);
+}
+
+/// Public scanner copied with only the saturation-mask value parameterized.
+fn child_mask_scan_body<T, E: Extract<T>>(
+    records: &[T],
+    candidate: Option<u128>,
+    extractor: &mut E,
+) -> u128 {
+    // The C reference scatters every digit, even digits that are constant in
+    // every key. The union and intersection of all keys find those digits
+    // without a histogram. A bit varies if it is set in the union but not in
+    // the intersection.
+    let mut union = extractor.key(&records[0]);
+    let mut intersection = union;
+    let full_mask = candidate.unwrap_or(u128::MAX >> (128 - E::Value::BITS));
+    // Wide random keys vary in every bit within the first few records, so
+    // stop after a 1,025-record prefix if they already do. Otherwise finish
+    // with one uninterrupted, vectorizable scan.
+    let boundary = records.len().min(1025);
+    for item in &records[1..boundary] {
+        let key = extractor.key(item);
+        union |= key;
+        intersection = intersection & key;
+    }
+    if union.to_u128() ^ intersection.to_u128() != full_mask {
+        for item in &records[boundary..] {
+            let key = extractor.key(item);
+            union |= key;
+            intersection = intersection & key;
+        }
+    }
+    union.to_u128() ^ intersection.to_u128()
+}
+
+/// Selects diagnostic extraction without affecting a non-diagnostic build.
+fn child_mask_scan<T, E: Extract<T>>(
+    records: &[T],
+    candidate: Option<u128>,
+    extractor: &mut E,
+) -> u128 {
+    #[cfg(not(feature = "child-scan-diagnostics"))]
+    {
+        child_mask_scan_body(records, candidate, extractor)
+    }
+    #[cfg(feature = "child-scan-diagnostics")]
+    {
+        child_mask_count_scan(records, extractor, |records, extractor| {
+            child_mask_scan_body(records, candidate, extractor)
+        })
+    }
+}
+
+/// Counts only the initial scan's real key calls, never recursive scans or probes.
+#[cfg(feature = "child-scan-diagnostics")]
+fn child_mask_count_scan<T, E: Extract<T>>(
+    records: &[T],
+    extractor: &mut E,
+    scan: impl FnOnce(&[T], &mut ChildMaskCounter<'_, E>) -> u128,
+) -> u128 {
+    let mut counted = ChildMaskCounter {
+        extractor,
+        examined: 0,
+    };
+    let varying = scan(records, &mut counted);
+    crate::child_mask::diagnostics::record_scan(counted.examined, varying);
+    varying
+}
+
+/// Wraps only a variation scanner, whose sole extractor operation is `key`.
+#[cfg(feature = "child-scan-diagnostics")]
+struct ChildMaskCounter<'a, E> {
+    extractor: &'a mut E,
+    examined: usize,
+}
+
+#[cfg(feature = "child-scan-diagnostics")]
+impl<T, E: Extract<T>> Extract<T> for ChildMaskCounter<'_, E> {
+    type Value = E::Value;
+    fn key(&mut self, record: &T) -> Self::Value {
+        self.examined += 1;
+        self.extractor.key(record)
+    }
+}

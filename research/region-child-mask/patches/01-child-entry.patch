+// SPDX-License-Identifier: BSD-2-Clause
+
+//! Per-child evidence with local scan counters, not per-key shared atomics.
+
+use super::ChildMode;
+use std::{cell::RefCell, sync::Mutex};
+
+/// Evidence for one actual child invocation, including preparation early exits.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ChildReport {
+    pub mode: ChildMode,
+    pub len: usize,
+    pub candidate: u128,
+    pub fixed_bits: u128,
+    pub actual_varying: u128,
+    pub sampled_order: Option<&'static str>,
+    pub insertion_probe_len: Option<usize>,
+    pub insertion_capture_keys: usize,
+    pub insertion_finished: Option<bool>,
+    pub scan_keys: Option<usize>,
+    pub scan_early_return: bool,
+    pub scan_varying: Option<u128>,
+    pub node_entered: bool,
+}
+
+std::thread_local! {
+    static CURRENT: RefCell<Option<ChildReport>> = const { RefCell::new(None) };
+}
+static FINISHED: Mutex<Vec<ChildReport>> = Mutex::new(Vec::new());
+
+/// Publishes one completed invocation; this is not a panic-recovery claim.
+pub(crate) struct ChildGuard;
+impl Drop for ChildGuard {
+    fn drop(&mut self) {
+        let report = CURRENT.with(|slot| slot.borrow_mut().take().unwrap());
+        FINISHED.lock().unwrap().push(report);
+    }
+}
+
+/// Validates the root-mask premise against every input key outside measured work.
+pub(crate) fn begin_child<T>(
+    records: &[T],
+    key: impl Fn(&T) -> u64,
+    mode: ChildMode,
+    candidate: u128,
+) -> ChildGuard {
+    assert_eq!(candidate >> 64, 0);
+    let (mut union, mut intersection) = (0u64, u64::MAX);
+    for record in records {
+        let value = key(record);
+        union |= value;
+        intersection &= value;
+    }
+    let actual_varying = if records.is_empty() {
+        0
+    } else {
+        (union ^ intersection) as u128
+    };
+    assert_eq!(
+        actual_varying & !candidate,
+        0,
+        "candidate excludes a varying bit"
+    );
+    let report = ChildReport {
+        mode,
+        len: records.len(),
+        candidate,
+        fixed_bits: records
+            .first()
+            .map_or(0, |record| key(record) as u128 & !candidate),
+        actual_varying,
+        sampled_order: None,
+        insertion_probe_len: None,
+        insertion_capture_keys: 0,
+        insertion_finished: None,
+        scan_keys: None,
+        scan_early_return: false,
+        scan_varying: None,
+        node_entered: false,
+    };
+    CURRENT.with(|slot| assert!(slot.borrow_mut().replace(report).is_none()));
+    ChildGuard
+}
+
+/// Notes the public order probe's actual result.
+pub(crate) fn record_order(order: &'static str) {
+    update(|report| report.sampled_order = Some(order));
+}
+
+/// Notes actual insertion preparation and whether it finished the child.
+pub(crate) fn record_insertion(probe_len: usize, len: usize, finished: bool) {
+    update(|report| {
+        report.insertion_probe_len = Some(probe_len);
+        report.insertion_capture_keys = if probe_len < len { probe_len } else { 0 };
+        report.insertion_finished = Some(finished);
+    });
+}
+
+/// Records actual key calls made by the initial variation scanner only.
+pub(crate) fn record_scan(examined: usize, varying: u128) {
+    update(|report| {
+        assert!(
+            report.scan_keys.is_none(),
+            "initial child scan occurred twice"
+        );
+        assert!(examined <= report.len);
+        assert_eq!(
+            varying, report.actual_varying,
+            "candidate scan lost variation"
+        );
+        report.scan_keys = Some(examined);
+        report.scan_early_return = examined < report.len;
+        report.scan_varying = Some(varying);
+    });
+}
+
+/// Marks the actual downstream node entry after all public preparation.
+pub(crate) fn record_node() {
+    update(|report| report.node_entered = true);
+}
+
+/// Applies a stage update when this invocation is one of the research children.
+fn update(change: impl FnOnce(&mut ChildReport)) {
+    CURRENT.with(|slot| {
+        if let Some(report) = slot.borrow_mut().as_mut() {
+            change(report);
+        }
+    });
+}
+
+/// Takes completed reports after all root jobs have joined.
+pub fn take_reports() -> Vec<ChildReport> {
+    core::mem::take(&mut *FINISHED.lock().unwrap())
+}
